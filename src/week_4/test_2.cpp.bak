#include <Arduino.h>
#include "Uno_serial.h"
#include "Uno_pin.h"
#include "switch.h"

// UNO + switch module (GND, VCC, OUT)
// GND -> GND, VCC -> 5V, OUT -> D2
// the switch's state goes to the USB serial as text:
//   pio device monitor        (platformio.ini: monitor_speed = 1000000)
//
// every change at once:     "on  (level HIGH), presses 3, was off for 1520 ms"
// every second, a status:   "      level LOW, off for 2300 ms"
// if "on" shows while the switch is not pressed, flip ACTIVE_HIGH below
constexpr bool ACTIVE_HIGH = true;
using SwitchPin = Uno::UnoPin<2>;
using Link = Uno::UnoSerial<1000000>;
switches::Switch<SwitchPin, ACTIVE_HIGH> button;

constexpr uint16_t STATUS_MS = 1000;
uint32_t nextStatusMs = 0;

// ---------- text over the serial link ----------

void printText(const char *text) {
    while (*text) {
        Link::write8((uint8_t)*text);
        text++;
    }
}

void printNumber(uint32_t value) {
    char digits[11];
    uint8_t i = sizeof(digits) - 1;
    digits[i] = '\0';
    do {
        i--;
        digits[i] = (char)('0' + value % 10);
        value /= 10;
    } while (value > 0);
    printText(&digits[i]);
}

void printLevel() {
    printText(button.readLevel() ? "level HIGH" : "level LOW");
}

// ---------- test ----------

void setup() {
    Link::init();
    button.init();
    printText("\r\nswitch on D2, ACTIVE_HIGH = ");
    printText(ACTIVE_HIGH ? "true" : "false");
    printText("\r\nstarts ");
    printText(button.isOn() ? "on, " : "off, ");
    printLevel();
    printText("\r\n");
    nextStatusMs = millis() + STATUS_MS;
}

void loop() {
    if (button.update()) {
        printText(button.isOn() ? "on  (" : "off (");
        printLevel();
        printText("), presses ");
        printNumber(button.pressCount());
        printText(button.isOn() ? ", was off for " : ", was on for ");
        printNumber(button.lastStateMs());
        printText(" ms\r\n");
        // drop the flags: this test only prints
        button.wasPressed();
        button.wasReleased();
    }
    if ((int32_t)(millis() - nextStatusMs) >= 0) {
        nextStatusMs += STATUS_MS;
        printText("      ");
        printLevel();
        printText(button.isOn() ? ", on for " : ", off for ");
        printNumber(button.stateMs());
        printText(" ms\r\n");
    }
}
