#include <Arduino.h>
#include "Uno_I2C.h"
#include "SSD1306.h"
#include "video.h"

// UNO + 128x64 I2C OLED: an animation (lib/video), looping
//   OLED: GND -> GND, VCC -> 5V, SCL -> D13, SDA -> D11
//
// the animation is black / white (the OLED has no colors), made by lib/video/source/convert.py:
//   python -B source/convert.py assets/orbit.gif output --target uno --fit 64x64 --mono --keyframe 8
// video::FlashPlayer draws a frame through setWindow / writeData16 (like on the ST7789);
// on the OLED those fill its RAM copy, then display() sends only the columns that changed
using Bus = Uno::UnoI2C<13, 11>;
using Screen = SSD1306::OLED128x64<Bus>;
using Orbit = animation::orbit_uno_64x64_palette_16_mono; // 64 x 64, 24 frames, 1440 ms
Screen screen;
video::FlashPlayer<Screen> player(screen);

// nothing answered at 0x3C, or the animation does not fit: stop
void halt() {
    while (true) {
    }
}

void setup() {
    if (!screen.init()) {
        halt();
    }
    // in the middle: (128 - 64) / 2
    if (!player.start<Orbit>(32, 0)) {
        halt();
    }
}

void loop() {
    // a frame is due: drawn into the RAM copy, then sent
    if (player.update()) {
        screen.display();
    }
}
