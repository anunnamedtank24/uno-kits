#include <Arduino.h>
#include "Uno_I2C.h"
#include "Uno_pin.h"
#include "module/OLED_128x64.h"
#include "image.h"
#include "switch.h"

// UNO + 128x64 I2C OLED + switch module: every press shows the next photo
//   OLED:   GND -> GND, VCC -> 5V, SCL -> D13, SDA -> D11
//   switch: GND -> GND, VCC -> 5V, OUT -> D2
//
// the photos are black / white (the OLED has no colors), made by lib/image/source/convert.py:
//   python -B source/convert.py assets/moon.jpg output --target uno --fill 128x64 --palette 2 --dither
// a photo is drawn into the OLED's RAM copy, then display() sends the bytes that changed
using Bus = Uno::UnoI2C<13, 11>;
using Screen = SSD1306::OLED128x64<Bus>;
using SwitchPin = Uno::UnoPin<2>;
Screen screen;
switches::Switch<SwitchPin> button;   // ACTIVE_HIGH: see src/week_4/test_2.cpp

// ---------- photos ----------

template <class Picture>
void drawPicture() {
    image::FlashImage<Screen> pictures(screen);
    pictures.draw<Picture>(0, 0);
}

void (*const photos[])() = {
    drawPicture<picture::sunset_uno_128x64_palette_2>,
    drawPicture<picture::moon_uno_128x64_palette_2>,
    drawPicture<picture::city_uno_128x64_palette_2>,
    drawPicture<picture::logo_uno_mac_128x64_palette_2>,
};
constexpr uint8_t PHOTO_COUNT = sizeof(photos) / sizeof(photos[0]);

uint8_t photo = 0;

void showPhoto() {
    screen.clear();
    photos[photo]();
    screen.display();
}

// ---------- main ----------

// nothing answered at 0x3C: stop (the built-in LED is on SCL, it cannot blink)
void halt() {
    while (true) {
    }
}

void setup() {
    if (!screen.init()) {
        halt();
    }
    button.init();
    showPhoto();
}

void loop() {
    button.update();
    if (button.wasPressed()) {
        photo = (uint8_t)((photo + 1) % PHOTO_COUNT);
        showPhoto();
    }
}
