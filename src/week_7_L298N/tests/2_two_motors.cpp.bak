#include <Arduino.h>
#include "Uno_serial.h"
#include "Uno_pin.h"
#include "L298N.h"

// UNO + L298N board + 2 DC motors (a two-wheeled car: A = left wheel, B = right wheel), told on the USB serial
//   OUT1, OUT2 -> motor A (left)   OUT3, OUT4 -> motor B (right)
//   pio device monitor        (platformio.ini: monitor_speed = BAUD)
//
// the moves of a car with two driven wheels (differential drive): the speed difference steers
//   straight: both the same          arc: one slower            pivot: one stopped
//   spin in place: opposite          and each wheel alone, to check which one is which
// on a car: lift it up (wheels in the air) the first time
//
// a wheel turns the wrong way? swap its two wires, or LEFT_REVERSED / RIGHT_REVERSED = true
// (on a car the two motors face opposite ways, so one of them usually has to be reversed)

// ---------- settings ----------

// wiring: L298N with both EN jumpers removed
//   +12V -> battery + (6 ~ 12 V)   GND -> battery - AND the UNO's GND   +5V: nothing (5V-EN jumper on)
constexpr uint8_t ENA_PIN = 5;              // ENA: a PWM pin (3, 5, 6, 9, 10, 11): the speed of channel A
constexpr uint8_t IN1_PIN = A0;             // IN1: any pin
constexpr uint8_t IN2_PIN = A1;             // IN2
constexpr uint8_t IN3_PIN = A2;             // IN3
constexpr uint8_t IN4_PIN = A3;             // IN4
constexpr uint8_t ENB_PIN = 6;              // ENB: a PWM pin: the speed of channel B
constexpr uint32_t BAUD = 1000000;          // USB serial: the same as monitor_speed in platformio.ini

constexpr uint16_t RAMP_MS = 500;           // 0 -> 255 takes this long
constexpr uint8_t MIN_DUTY = 0;             // the dead zone (tests/4_pwm)
constexpr bool LEFT_REVERSED = false;
constexpr bool RIGHT_REVERSED = false;

// the moves, in order, then again from the first
struct Move {
    int16_t left;                           // speed, or BRAKE
    int16_t right;
    uint16_t ms;
    const char *text;
};
constexpr int16_t BRAKE = 1000;

const Move MOVES[] = {
    {150, 0, 2000, "1 left (A) alone, forward: is it the left wheel, going forward?"},
    {0, 150, 2000, "2 right (B) alone, forward: the right wheel, forward?"},
    {200, 200, 2500, "3 straight forward 200"},
    {BRAKE, BRAKE, 1000, "  brake both: stops straight (both at the same moment)"},
    {-200, -200, 2500, "4 straight backward 200"},
    {BRAKE, BRAKE, 1000, "  brake"},
    {200, 100, 3000, "5 arc to the right (left faster)"},
    {100, 200, 3000, "6 arc to the left (right faster)"},
    {200, BRAKE, 2000, "7 pivot right: the right wheel braked, the left drives"},
    {200, -200, 2000, "8 spin right in place (opposite)"},
    {-200, 200, 2000, "9 spin left in place"},
    {BRAKE, BRAKE, 1000, "  brake"},
    {255, 255, 2000, "10 both full: does one go faster? (motors differ: trim with the speeds)"},
    {0, 0, 3000, "  coast; again in 3 s"},
};
constexpr uint8_t MOVE_COUNT = sizeof(MOVES) / sizeof(MOVES[0]);

// ---------- parts ----------

using Board = L298N::L298NBoard<Uno::UnoPwmPin<ENA_PIN>,
                                Uno::UnoOutputPin<IN1_PIN>, Uno::UnoOutputPin<IN2_PIN>,
                                Uno::UnoOutputPin<IN3_PIN>, Uno::UnoOutputPin<IN4_PIN>,
                                Uno::UnoPwmPin<ENB_PIN>>;
// both EN jumpers on instead (ENA, ENB not connected), full speed only:
//   L298N::L298NBoard<L298N::EnableJumper, ..., L298N::EnableJumper>
using Link = Uno::UnoSerial<BAUD>;

L298N::DCMotor<Board::A> left;
L298N::DCMotor<Board::B> right;


uint8_t moveIndex = 0;
uint32_t moveStartMs = 0;

// ---------- test ----------

template <class Motor>
void drive(Motor &motor, int16_t speed) {
    if (speed == BRAKE) {
        motor.brake();
    } else {
        motor.setSpeed(speed);
    }
}

void startMove() {
    const Move &move = MOVES[moveIndex];
    drive(left, move.left);
    drive(right, move.right);
    Link::printText(move.text);
    Link::printText("\r\n");
    moveStartMs = millis();
}

// ---------- main ----------

void setup() {
    Link::init();
    left.init();
    right.init();
    left.setRampMs(RAMP_MS);
    right.setRampMs(RAMP_MS);
    left.setMinDuty(MIN_DUTY);
    right.setMinDuty(MIN_DUTY);
    left.setReversed(LEFT_REVERSED);
    right.setReversed(RIGHT_REVERSED);
    Link::printText("\r\nL298N two motors: left = A (ENA ");
    Link::printPin(ENA_PIN);
    Link::printText(", IN1 ");
    Link::printPin(IN1_PIN);
    Link::printText(", IN2 ");
    Link::printPin(IN2_PIN);
    Link::printText("), right = B (IN3 ");
    Link::printPin(IN3_PIN);
    Link::printText(", IN4 ");
    Link::printPin(IN4_PIN);
    Link::printText(", ENB ");
    Link::printPin(ENB_PIN);
    Link::printText(")\r\n");
    startMove();
}

void loop() {
    left.update();
    right.update();
    if (millis() - moveStartMs >= MOVES[moveIndex].ms) {
        moveIndex = (uint8_t)((moveIndex + 1) % MOVE_COUNT);
        startMove();
    }
}
