#include <Arduino.h>
#include "Uno_serial.h"
#include "Uno_ST7789.h"
#include "ST7789.h"
#include "graphics.h"
#include "color.h"
#include "font.h"
#include "video.h"
#include "stream.h"

// UNO + M130T (1.3" 240x240, no CS): every function of graphics, font and video, one test after another
// test 19 needs lib/stream/source/stream.py (python lib/stream/source/stream.py)

// ---------- settings ----------

// wiring: M130T VCC -> 3.3V, GND -> GND, SCL -> D13, SDA -> D11 (hardware SPI: fixed)
constexpr uint8_t DC_PIN = 8;               // DC
constexpr uint8_t RES_PIN = 10;             // RES; Uno::NONE: not connected (software reset)
constexpr uint8_t CS_PIN = Uno::NONE;       // CS: the M130T has none
constexpr uint8_t BLK_PIN = 9;              // BLK (backlight); Uno::NONE: tied to VCC
constexpr uint32_t BAUD = 1000000;          // USB serial for stream.py (its --baud)

constexpr uint32_t ONLY_TESTS = 0;          // 0: every test; bit i = only test i, e.g. (1UL << 14) | (1UL << 20)
constexpr uint16_t TITLE_MS = 1000;         // "test n" before each test
constexpr uint16_t HOLD_MS = 1000;          // the result stays this long
constexpr uint16_t VIDEO_MS = 4000;         // test 18: how long the orbit plays
constexpr uint16_t LATE_MS = 1000;          // test 18: then nothing calls update() this long
constexpr uint16_t STREAM_WAIT_MS = 10000;  // test 19: waits this long for stream.py
constexpr uint16_t STREAM_STEP_MS = 3000;   // test 19: each step (play, pause, seek, speed, loop off)
constexpr uint8_t STREAM_CHUNK = 64;        // test 19: bytes per request to stream.py

// ---------- parts ----------

using Bus = Uno::UnoST7789<DC_PIN, RES_PIN, CS_PIN, BLK_PIN>;
using ScreenColor = color::RGB565;                 // M130T: 16 bit (RGB888 / RGB666: 18 bit, RGB444: 12 bit)
using Screen = graphics::Canvas<ST7789::M130T<Bus, ScreenColor>>;
using Link = Uno::UnoSerial<BAUD>;
using StreamLink = stream::Puller<Link, STREAM_CHUNK>;   // asks stream.py for files
using RGB565 = color::RGB565;
using SmallPrintable = font::menlo_height_23_first_32_last_126_default_63;  // 8 x 23, ASCII 32 ~ 126
using BigDigits = font::menlo_height_46_first_48_last_57_default_63;       // 16 x 46, '0' ~ '9' + '?'
using Orbit = animation::orbit_flash_120x120_palette_16; // 60 x 60 drawn as 120 x 120, 8 colors, 24 frames, 60 ms
using OrbitStream = animation::orbit_stream_120x120_palette_565; // frames on the computer, 120 x 120 RGB565
using StreamPlayer = video::StreamPlayer<Screen, StreamLink>;
Screen screen;

void clear() {
    screen.drawFilledScreen(RGB565::BLACK);
}

// ---------- tests ----------

// 0. solid colors: checks init, RGB/BGR order and inversion
//    expected: red -> green -> blue -> white -> black
void testColors() {
    const uint16_t colors[] = {
        RGB565::RED, 
        RGB565::GREEN, 
        RGB565::BLUE, 
        RGB565::WHITE, 
        RGB565::BLACK, 
        RGB565::YELLOW,
    };
    for (uint8_t i = 0; i < sizeof(colors) / sizeof(colors[0]); i++) {
        screen.drawFilledScreen(colors[i]);
    }
}

// 1. 1-px border + corner marks: checks size and offset
//    expected: white frame touching all 4 edges, red/green/blue/yellow corners
void testBorder() {
    screen.drawHollowRectSize(0, 0, screen.width(), screen.height(), RGB565::WHITE);
    screen.drawFilledRectSize(0, 0, 10, 10, RGB565::RED);
    screen.drawFilledRectSize(screen.width() - 10, 0, 10, 10, RGB565::GREEN);
    screen.drawFilledRectSize(0, screen.height() - 10, 10, 10, RGB565::BLUE);
    screen.drawFilledRectSize(screen.width() - 10, screen.height() - 10, 10, 10, RGB565::YELLOW);
}

// 2. ST7789::Window::fillWindow and ST7789::Window::writeWindow
//    expected: 3 solid rects on top, 4 gradient tiles below,
//              3 tiles touching the left, right and bottom edges
uint16_t gradient[16 * 16];

void testRamRect() {
    screen.fillWindow(10, 10, 60, 40, RGB565::RED);
    screen.fillWindow(90, 10, 60, 40, RGB565::GREEN);
    screen.fillWindow(170, 10, 60, 40, RGB565::BLUE);

    // red grows to the right, blue grows down
    for (uint8_t y = 0; y < 16; y++) {
        for (uint8_t x = 0; x < 16; x++) {
            gradient[y * 16 + x] = RGB565::color(x * 16, (x + y) * 8, y * 16);
        }
    }
    for (uint8_t i = 0; i < 4; i++) {
        screen.writeWindow(20 + i * 56, 80, 16, 16, gradient);
    }
    screen.writeWindow(0, 140, 16, 16, gradient);
    screen.writeWindow(224, 140, 16, 16, gradient);
    screen.writeWindow(112, 224, 16, 16, gradient);
}

// 3. point
//    expected: dotted grid every 10 px
void testPoint() {
    for (int16_t y = 5; y < (int16_t)screen.height(); y += 10) {
        for (int16_t x = 5; x < (int16_t)screen.width(); x += 10) {
            screen.drawPoint(x, y, RGB565::WHITE);
        }
    }
}

// 4. horizontal / vertical lines, 3 forms each
//    expected: each group of 3 lines (red / green / blue) is identical: x 20..119
void testHVLines() {
    // horizontal: x 20 ~ 119
    screen.drawHLineSize(20, 20, 100, RGB565::RED);
    screen.drawHLinePoints(119, 20, 30, RGB565::GREEN);   // reversed order on purpose
    screen.drawHLineCenter(70, 40, 100, RGB565::BLUE);
    // vertical: y 120 ~ 219
    screen.drawVLineSize(20, 120, 100, RGB565::RED);
    screen.drawVLinePoints(30, 219, 120, RGB565::GREEN);
    screen.drawVLineCenter(40, 170, 100, RGB565::BLUE);
}

// 5. lines, 3 forms
//    expected: left fan (Points), middle star (Angle, every 30 deg), right box X (Delta)
void testLines() {
    for (int16_t y = 0; y < 240; y += 24) {
        screen.drawLinePoints(0, 120, 70, y, RGB565::CYAN);
    }
    for (int16_t deg = 0; deg < 360; deg += 30) {
        screen.drawLineAngle(120, 120, 40, deg, deg == 0 ? RGB565::RED : RGB565::YELLOW); // red = 0 deg, right
    }
    screen.drawLineAngle(120, 120, 40, 90, RGB565::GREEN); // green = 90 deg, up
    screen.drawLineDelta(170, 90, 60, 60, RGB565::MAGENTA);
    screen.drawLineDelta(230, 90, -60, 60, RGB565::MAGENTA);
}

// 6. rectangles, 3 forms
//    expected: top row outline, bottom row filled; in each row the 3 shapes have the same size
void testRects() {
    screen.drawHollowRectSize(10, 20, 60, 80, RGB565::RED);
    screen.drawHollowRectPoints(149, 99, 90, 20, RGB565::GREEN);  // reversed corners on purpose
    screen.drawHollowRectCenter(200, 60, 60, 80, RGB565::BLUE);

    screen.drawFilledRectSize(10, 140, 60, 80, RGB565::RED);
    screen.drawFilledRectPoints(149, 219, 90, 140, RGB565::GREEN);
    screen.drawFilledRectCenter(200, 180, 60, 80, RGB565::BLUE);
}

// 7. triangles, 3 forms
//    expected: top row outline, bottom row filled
void testTriangles() {
    screen.drawHollowTrianglePoints(10, 100, 40, 20, 70, 90, RGB565::CYAN);
    screen.drawHollowTriangleSize(90, 20, 60, 80, RGB565::YELLOW);
    screen.drawHollowTriangleCenter(200, 60, 60, 80, RGB565::MAGENTA);

    screen.drawFilledTrianglePoints(10, 220, 40, 140, 70, 210, RGB565::CYAN);
    screen.drawFilledTriangleSize(90, 140, 60, 80, RGB565::YELLOW);
    screen.drawFilledTriangleCenter(200, 180, 60, 80, RGB565::MAGENTA);
    screen.drawHollowTriangleCenter(200, 180, 60, 80, RGB565::WHITE); // outline must sit on the fill edge
}

// 8. circles, 2 forms
//    expected: left column Radius, right column Points (same size); small white dot = the given point
void testCircles() {
    screen.drawHollowCircleRadius(60, 60, 40, RGB565::GREEN);
    screen.drawHollowCirclePoints(180, 60, 204, 92, RGB565::GREEN); // distance = 40
    screen.drawPoint(204, 92, RGB565::WHITE);

    screen.drawFilledCircleRadius(60, 180, 40, RGB565::ORANGE);
    screen.drawFilledCirclePoints(180, 180, 180, 140, RGB565::ORANGE); // distance = 40
    screen.drawHollowCircleRadius(180, 180, 40, RGB565::WHITE);       // outline must sit on the fill edge
}

// 9. border width of hollow shapes: (x, y, w, h) / corners / radius are the outer edge, the border grows inward
//     expected: 3 columns: border 1, 6, and 40 (wider than half: solid)
//               rows: rectangles, triangles, circles
//               each one is drawn over a gray filled shape of the same size: no gray outside the colored border
void testBorders() {
    const int16_t borders[] = { 1, 6, 40 };
    for (uint8_t i = 0; i < 3; i++) {
        int16_t x = 10 + i * 78;
        screen.drawFilledRectSize(x, 8, 64, 64, RGB565::GRAY);
        screen.drawHollowRectSize(x, 8, 64, 64, RGB565::RED, borders[i]);

        screen.drawFilledTrianglePoints(x, 150, x + 20, 80, x + 63, 140, RGB565::GRAY);
        screen.drawHollowTrianglePoints(x, 150, x + 20, 80, x + 63, 140, RGB565::GREEN, borders[i]);

        screen.drawFilledCircleRadius(x + 32, 196, 32, RGB565::GRAY);
        screen.drawHollowCircleRadius(x + 32, 196, 32, RGB565::CYAN, borders[i]);
    }
}

// 10. screen edges: shapes touching the edges exactly (0 and 239), nothing may be cut
//     expected: red square at the top-left corner, green half disc on the right edge,
//               blue triangle with its tip on the top edge, yellow ring on the bottom edge,
//               white line from the left edge (y 180) to the right edge (y 40), gray line on the bottom row;
//               nothing wraps around
void testClip() {
    screen.drawFilledRectSize(0, 0, 40, 40, RGB565::RED);
    screen.drawFilledCircleRadius(199, 120, 40, RGB565::GREEN);
    screen.drawFilledTrianglePoints(130, 0, 100, 60, 160, 60, RGB565::BLUE);
    screen.drawHollowCircleRadius(120, 199, 40, RGB565::YELLOW);
    screen.drawLinePoints(0, 180, 239, 40, RGB565::WHITE);
    screen.drawHLineSize(0, 239, 240, RGB565::GRAY);
}

// ---------- text tests (font SmallPrintable: 8 x 23, 30 chars x 10 lines) ----------

constexpr int16_t LINE = 24;

// 11. every char of the font, drawn one by one with the returned x
//     expected: ' ' ~ '~' in 4 lines, no gaps, no overlap
void testTextChars() {
    int16_t x = 0;
    int16_t y = 0;
    for (uint8_t code = 32; code <= 126; code++) {
        if (x + 8 > (int16_t)screen.width()) {
            x = 0;
            y += LINE;
        }
        x = screen.drawTexts(x, y, RGB565::WHITE, (char)code);
    }
}

// 12. value types: strings, char, every integer type
//     expected (each line):
//       const char*: abc        char[]: buffer          F(): Arduino
//       char: Az                int8/uint8: -5 200      int: -123 65535 true
//       long: -2147483648       ulong: 4294967295
void testTextTypes() {
    char buffer[] = "buffer";

    screen.drawTexts(0, LINE * 0, RGB565::WHITE, "const char*: ", "abc");
    screen.drawTexts(0, LINE * 1, RGB565::WHITE, "char[]: ", buffer);
    screen.drawTexts(0, LINE * 2, RGB565::WHITE, "F(): ", F("Arduino"));
    screen.drawTexts(0, LINE * 3, RGB565::WHITE, "char: ", 'A', 'z');
    screen.drawTexts(0, LINE * 4, RGB565::WHITE, "int8/uint8: ", (int8_t)-5, ' ', (uint8_t)200);
    screen.drawTexts(0, LINE * 5, RGB565::WHITE, "int: ", -123, ' ', 65535U, ' ', true);
    screen.drawTexts(0, LINE * 6, RGB565::WHITE, "long: ", -2147483647L - 1);
    screen.drawTexts(0, LINE * 7, RGB565::WHITE, "ulong: ", 4294967295UL);
}

// 13. float / double, setDecimals
//     expected:
//       float: 3.14             round: 2.35 -1.50       double: 2.50
//       nan inf: nan inf -inf   1e10: ovf
//       decimals 0: 3           decimals 4: 3.1416
void testTextFloat() {
    screen.drawTexts(0, LINE * 0, RGB565::WHITE, "float: ", 3.14159f);
    screen.drawTexts(0, LINE * 1, RGB565::WHITE, "round: ", 2.345f, ' ', -1.5f);
    screen.drawTexts(0, LINE * 2, RGB565::WHITE, "double: ", 2.5);
    screen.drawTexts(0, LINE * 3, RGB565::WHITE, "nan inf: ", NAN, ' ', INFINITY, ' ', -INFINITY);
    screen.drawTexts(0, LINE * 4, RGB565::WHITE, "1e10: ", 1e10f);

    screen.setDecimals(0);
    screen.drawTexts(0, LINE * 5, RGB565::CYAN, "decimals 0: ", 2.5f);
    screen.setDecimals(4);
    screen.drawTexts(0, LINE * 6, RGB565::CYAN, "decimals 4: ", 3.14159f);
    screen.setDecimals(2);
}

// 14. arrays, setSeparator
//     expected:
//       int[]: 123              (no separator by default)
//       int[]: 1, 2, 3          float[]: 1.50, -2.25
//       char*[]: ab, cd, ef     uint8[]: 10, 20, 255
//       mixed: 1|2|3 / ab|cd|ef
void testTextArrays() {
    const int ints[] = {1, 2, 3};
    const float floats[] = {1.5f, -2.25f};
    const char *words[] = {"ab", "cd", "ef"};
    const uint8_t bytes[] = {10, 20, 255};

    screen.drawTexts(0, LINE * 0, RGB565::WHITE, "int[]: ", ints);
    screen.setSeparator(", ");
    screen.drawTexts(0, LINE * 1, RGB565::WHITE, "int[]: ", ints);
    screen.drawTexts(0, LINE * 2, RGB565::WHITE, "float[]: ", floats);
    screen.drawTexts(0, LINE * 3, RGB565::WHITE, "char*[]: ", words);
    screen.drawTexts(0, LINE * 4, RGB565::WHITE, "uint8[]: ", bytes);
    screen.setSeparator("|");
    screen.drawTexts(0, LINE * 5, RGB565::CYAN, "mixed: ", ints, " / ", words);
    screen.setSeparator("");
}

// 15. default char for codes outside first ~ last
//     expected:
//       tab:?|   utf-8:??|   newline:?|   code 200:?|          (font SmallPrintable)
//       12?34                                                  (font BigDigits, ':' not in it)
//       ?5?3?50                                                ('-' and '.' not in it)
void testTextDefault() {
    screen.drawTexts(0, LINE * 0, RGB565::WHITE, "tab:\t|");
    screen.drawTexts(0, LINE * 1, RGB565::WHITE, "utf-8:\xC3\xA9|");
    screen.drawTexts(0, LINE * 2, RGB565::WHITE, "newline:\n|");
    screen.drawTexts(0, LINE * 3, RGB565::WHITE, "code 200:", (char)200, '|');

    screen.setFont<BigDigits>();
    screen.drawTexts(0, 100, RGB565::YELLOW, "12:34");
    screen.drawTexts(0, 150, RGB565::YELLOW, -5, ' ', 3.5f);
    screen.setFont<SmallPrintable>();
}

// 16. layout: transparent background, returned x, empty call, fontHeight, clipping
//     expected:
//       white text over blue / red: background stays around every letter
//       red "ABC" and green "ABC" 2 px apart: both visible
//       "x=123" then a magenta bar right after it, then "(x)" with its value
//       "empty ok", "fontHeight=23", "F() in flash false" 
//       "left edge" at x 0, "right edge" ending at x 239, "bottom" on the last text line (y 217)
void testTextLayout() {
    screen.drawFilledRectSize(0, 0, 120, 30, RGB565::BLUE);
    screen.drawFilledRectSize(120, 0, 120, 30, RGB565::RED);
    screen.drawTexts(40, 4, RGB565::WHITE, "transparent text");

    screen.drawTexts(10, 34, RGB565::RED, "ABC");
    screen.drawTexts(12, 34, RGB565::GREEN, "ABC");

    int16_t x = screen.drawTexts(10, 64, RGB565::WHITE, "x=");
    x = screen.drawTexts(x, 64, RGB565::CYAN, 123);
    screen.drawFilledRectSize(x, 64, 3, screen.fontHeight(), RGB565::MAGENTA);
    screen.drawTexts(x + 6, 64, RGB565::WHITE, "(", x, ")");

    int16_t empty = screen.drawTexts(50, 94, RGB565::WHITE);
    screen.drawTexts(10, 94, RGB565::WHITE, empty == 50 ? "empty ok" : "empty FAIL");
    screen.drawTexts(10, 124, RGB565::WHITE, "fontHeight=", screen.fontHeight());
    screen.drawTexts(10, 190, RGB565::WHITE, F("F() in flash"), ' ', false);

    screen.drawTexts(0, 160, RGB565::YELLOW, "left edge");
    screen.drawTexts(240 - 10 * 8, 160, RGB565::YELLOW, "right edge");
    screen.drawTexts(10, 240 - 23, RGB565::YELLOW, "bottom");
}

// 17. setAutoLineBreak, setLineSpacing
//     expected:
//       y 0   "line 1" / "line 2" / "3 follows"          ('\n' starts a new line at x 0)
//       y 72  "this sentence is too long for" / "one line" + magenta bar after it (returned x)
//       y 124 "start x 120 wra" / "ps" both starting at x 120
//       y 170 "gap 20" / "gap 20" with a 20 px gap
//       top right: 'A' and 'B' on 2 lines, both ending at x 239 (a char that fits is never wrapped)
void testTextLineBreak() {
    screen.setAutoLineBreak(true);

    screen.drawTexts(0, 0, RGB565::WHITE, "line 1\nline 2\n", 3, " follows");

    int16_t x = screen.drawTexts(0, 72, RGB565::YELLOW, "this sentence is too long for one line");
    screen.drawFilledRectSize(x, 72 + screen.fontHeight(), 3, screen.fontHeight(), RGB565::MAGENTA);

    screen.drawTexts(120, 124, RGB565::CYAN, "start x 120 wraps");

    screen.drawTexts(232, 0, RGB565::MAGENTA, "AB");

    screen.setLineSpacing(20);
    screen.drawTexts(0, 170, RGB565::GREEN, "gap 20\ngap 20");

    screen.setLineSpacing(0);
    screen.setAutoLineBreak(false);
}

// 18. video::FlashPlayer (lib/video/output, made by lib/video/source/convert.py)
//     expected: moon orbiting an orange planet in the middle, 1 turn every 1.44 s, for VIDEO_MS
//               then the "late" test (LATE_MS without update()): it jumps to an I frame, "skipped" > 0
void testVideoFlash() {
    // players live on the stack: their RAM is only used during the test
    video::FlashPlayer<Screen> player(screen);
    if (!player.start<Orbit>(60, 40)) {
        screen.drawTexts(10, 10, RGB565::RED, "does not fit");
        return;
    }
    uint32_t startMs = millis();
    while (millis() - startMs < VIDEO_MS) {
        player.update();
    }
    screen.drawTexts(10, 180, RGB565::WHITE, "frame ", player.frame(), " skipped ", player.skippedFrames());

    // a slow program: nothing calls update() for LATE_MS
    delay(LATE_MS);
    player.update();
    screen.drawTexts(10, 204, RGB565::YELLOW, "late: frame ", player.frame(), " skipped ", player.skippedFrames());
}

// 19. video::StreamPlayer over USB serial: the board knows the file, the computer only runs
//       python lib/stream/source/stream.py     (pip install pyserial; close the serial monitor)
//     (the file, in lib/video: python source/convert.py assets/orbit.gif output --target stream --fit 120x120 --palette 565)
//     expected: "waiting for stream.py" until it answers, then the orbit in full color with its status,
//     STREAM_STEP_MS each:
//       play         playing
//       pause        the moon stops
//       seek 720 ms  the moon jumps half a turn, still paused
//       speed 200 %  playing twice as fast
//       loop off     at 100 %: stops at the last frame, "ended"
//     (opening the port resets the board: start stream.py first, it waits for the board)
void showStreamStatus(StreamPlayer &player, const char *step) {
    screen.drawFilledRectSize(0, 170, screen.width(), 70, RGB565::BLACK);
    if (!player.isConnected()) {
        screen.drawTexts(10, 170, RGB565::YELLOW, "waiting for stream.py");
        screen.drawTexts(10, 194, RGB565::WHITE, "error ", player.error());
        return;
    }
    screen.drawTexts(10, 170, RGB565::GREEN, step);
    screen.drawTexts(10, 194, RGB565::WHITE, player.positionMs(), " ms, frame ", player.frame());
    screen.drawTexts(10, 218, RGB565::WHITE, player.isPlaying() ? "playing" : "paused", player.isEnded() ? " ended" : "");
}

void testVideoStream() {
    StreamPlayer player(screen);
    player.open<OrbitStream>(60, 40);

    // wait up to STREAM_WAIT_MS for stream.py
    uint32_t startMs = millis();
    uint32_t waitShownMs = 0;
    while (!player.isConnected() && millis() - startMs < STREAM_WAIT_MS) {
        player.update();
        if (millis() - waitShownMs >= 1000) {
            waitShownMs = millis();
            showStreamStatus(player, "");
        }
    }

    // each step: what to send at its start, then frames for its time, the status shown every 500 ms
    const char *const steps[] = { "play", "pause", "seek 720 ms", "speed 200 %", "loop off" };
    for (uint8_t i = 0; i < 5; i++) {
        if (i == 1) {
            player.pause();
        } else if (i == 2) {
            player.seek(720);
        } else if (i == 3) {
            player.play();
            player.setSpeed(200);
        } else if (i == 4) {
            player.setSpeed(100);
            player.setLoop(false);
        }
        uint32_t stepStartMs = millis();
        uint32_t shownMs = 0;
        while (millis() - stepStartMs < STREAM_STEP_MS) {
            player.update();
            if (millis() - shownMs >= 500) {
                shownMs = millis();
                showStreamStatus(player, steps[i]);
            }
        }
    }
    showStreamStatus(player, "done");
    player.close();
}

// 20. clipping: shapes partly off the screen (fillWindow cuts every window to the screen)
//     expected: only the parts on the screen, nothing wraps to the other side or lands somewhere else
//     shapes: red rect past the left edge, green disc past the right edge, blue triangle past the top,
//             yellow ring past the bottom, white line past the left and right edges, magenta text past the right edge
void testOffScreen() {
    screen.drawFilledRectSize(-30, 100, 60, 40, RGB565::RED);
    screen.drawFilledCircleRadius(230, 120, 40, RGB565::GREEN);
    screen.drawFilledTrianglePoints(100, -40, 160, -40, 130, 40, RGB565::BLUE);
    screen.drawHollowCircleRadius(120, 230, 40, RGB565::YELLOW);
    screen.drawLinePoints(-40, 200, 280, 20, RGB565::WHITE);
    screen.drawTexts(200, 60, RGB565::MAGENTA, "off screen");
}

void (*const tests[])() = {
    testColors,
    testBorder,
    testRamRect,
    testPoint,
    testHVLines,
    testLines,
    testRects,
    testTriangles,
    testCircles,
    testBorders,
    testClip,
    testTextChars,
    testTextTypes,
    testTextFloat,
    testTextArrays,
    testTextDefault,
    testTextLayout,
    testTextLineBreak,
    testVideoFlash,
    testVideoStream,
    testOffScreen,
};

using Test = void (*)();

// the test's index in tests[], -1 if it is not there
int16_t testIndex(Test test) {
    for (uint8_t i = 0; i < sizeof(tests) / sizeof(tests[0]); i++) {
        if (tests[i] == test) {
            return i;
        }
    }
    return -1;
}

// "test {n}" in the middle of the screen for TITLE_MS, then erased
void showTitle(Test test) {
    const int16_t x = 88;
    const int16_t y = (240 - 23) / 2;
    int16_t end = screen.drawTexts(x, y, RGB565::WHITE, "test ", testIndex(test));
    delay(TITLE_MS);
    screen.drawFilledRectSize(x, y, end - x, screen.fontHeight(), RGB565::BLACK);
}

// runs every test of a list (only those in ONLY_TESTS, if any): its title first, HOLD_MS after it
// the list is taken by reference so its length N is known here
template <size_t N>
void testAll(const Test (&list)[N]) {
    for (size_t i = 0; i < N; i++) {
        if (ONLY_TESTS != 0 && !(ONLY_TESTS & (1UL << i))) {
            continue;
        }
        clear();
        showTitle(list[i]);
        list[i]();
        delay(HOLD_MS);
    }
}

// ---------- main ----------

void setup() {
    screen.init();
    clear();
    screen.setFont<SmallPrintable>();
}

static_assert(ONLY_TESTS < (1UL << (sizeof(tests) / sizeof(tests[0]))), "ONLY_TESTS: a bit for a test that is not there");

void loop() {
    testAll(tests);
}