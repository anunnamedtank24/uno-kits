#include <Arduino.h>
#include <stdio.h>
#include "Uno_ST7789.h"
#include "ST7789.h"
#include "graphics.h"
#include "color.h"
#include "font.h"

// UNO + M130T: ripples. Drops fall at random places on dark water; each sends out rings
// that spread, fade and pass through each other. The rain comes and goes by chance: long calm
// spells of a few big ripples, then a downpour of many small ones (see "the rain" below).
// No input needed: it plays by itself.
//
// smooth without a frame buffer (the UNO has 2 KB of RAM, the screen needs 112 KB):
//   - a ring is never cleared and drawn again: each time it grows, one strip is sent, from the
//     inner edge it leaves (black) to the outer edge it grows into (color); the pixels in between
//     get their own color again, so nothing flickers and a new brightness costs nothing extra
//   - every window sent to the screen costs ~32 us of address commands (CASET, RASET, RAMWR):
//     the strip is sent as horizontal runs at the top / bottom of a ring and vertical runs at its
//     sides (8 mirrored pieces), about 2.3 r windows a ring instead of 8 r for erase + draw by
//     columns; runs off the screen are skipped before any command
//   - the radius comes from the time since the drop, not from the frame count:
//     the speed stays the same however many rings are on the screen

// ---------- settings ----------

// wiring: M130T VCC -> 3.3V, GND -> GND, SCL -> D13, SDA -> D11 (hardware SPI: fixed)
constexpr uint8_t DC_PIN = 8;               // DC
constexpr uint8_t RES_PIN = 10;             // RES; Uno::NONE: not connected (software reset)
constexpr uint8_t CS_PIN = Uno::NONE;       // CS: the M130T has none
constexpr uint8_t BLK_PIN = 9;              // BLK (backlight); Uno::NONE: tied to VCC
using ScreenColor = color::RGB565;          // the screen's colors (lib/color): RGB565 16 bit (fastest), RGB888 / RGB666 18 bit, RGB444 12 bit

constexpr uint16_t SPEED = 24;          // px per second
constexpr int16_t BORDER = 3;           // ring width, px
constexpr uint8_t LEVELS = 24;          // brightness steps from full to black

// the rain: a random walk, squeezed by a sigmoid into 0 (calm) ~ 1 (downpour)
//   walk: every WALK_MS a step of -WALK_STEP ~ +WALK_STEP, bounced back at +-WALK_LIMIT
//   rain = 1 / (1 + e^(-walk / SIGMOID_SCALE)): flat at both ends, steep in the middle,
//   so it stays calm or pouring for a while and changes over in a few seconds
constexpr uint16_t WALK_MS = 200;
constexpr int8_t WALK_STEP = 20;
constexpr int8_t WALK_LIMIT = 40;
constexpr float SIGMOID_SCALE = 6.0f;

// calm (rain 0) ~ downpour (rain 1), in between mixed by rain
constexpr uint16_t CALM_DROP_MIN_MS = 900;    // between drops
constexpr uint16_t CALM_DROP_MAX_MS = 1800;
constexpr uint16_t POUR_DROP_MIN_MS = 70;
constexpr uint16_t POUR_DROP_MAX_MS = 180;
constexpr int16_t CALM_FADE_RADIUS = 70;      // a ring is gone (black) at this radius
constexpr int16_t POUR_FADE_RADIUS = 28;
constexpr int16_t CALM_DROP_RADIUS = 4;       // the drop itself, covered by its first ring
constexpr int16_t POUR_DROP_RADIUS = 2;
// rings of a calm drop: 1 ~ 3 by chance (1 the most); the more rain, the more often just 1
const uint8_t RING_COUNTS[] = { 1, 1, 1, 2, 2, 3 };
constexpr uint16_t RING_GAP_MIN_MS = 300;     // between the rings of one drop
constexpr uint16_t RING_GAP_MAX_MS = 500;

// smooth only while the UNO keeps up: one step of a ring costs about 1 + 0.24 r ms (measured),
// so a ring that fades at radius f costs about SPEED * (1 + 0.12 f) ms per second.
// a drop waits (is skipped) if its rings would go over the budget: 65 % of the time
// (the drops and the caption take a bit more: ~80 % in a downpour, measured),
// so every ring still moves 1 px per step; small downpour rings are cheap, so more of them fit
constexpr int32_t BUDGET = 650L * 100 / SPEED;    // in 1/100 ms per px of growth
constexpr uint8_t MAX_RINGS = 10;
constexpr int16_t DROP_MARGIN = 20;           // drops land at least this far from the edges

// the caption "No. {drops}" at the bottom left
constexpr int16_t CAPTION_X = 6;
constexpr uint8_t CAPTION_GRAY[] = { 110, 110, 120 };   // R, G, B

// colors of the water at full brightness
struct Rgb {
    uint8_t r;
    uint8_t g;
    uint8_t b;
};

const Rgb PALETTE[] = {
    { 120, 220, 255 },  // light cyan
    { 80, 150, 255 },   // blue
    { 90, 230, 190 },   // teal
    { 170, 140, 255 },  // violet
    { 230, 240, 255 },  // white
};
constexpr uint8_t PALETTE_SIZE = sizeof(PALETTE) / sizeof(PALETTE[0]);

// ---------- parts ----------

using Bus = Uno::UnoST7789<DC_PIN, RES_PIN, CS_PIN, BLK_PIN>;
using Screen = graphics::Canvas<ST7789::M130T<Bus, ScreenColor>>;
using Color = ScreenColor::Value;           // one color of the screen
using Font = font::menlo_height_23_first_32_last_126_default_63;

Screen screen;

constexpr int16_t SIZE = 240;

// ---------- rings ----------

struct Ring {
    bool active;
    int16_t cx;
    int16_t cy;
    uint32_t startMs;   // may be in the future: a later ring of a drop
    uint8_t color;      // index into PALETTE
    uint8_t firstLevel; // the later rings of a drop start dimmer
    int16_t fadeRadius; // black at this radius
    int16_t radius;     // outer radius drawn so far
};

Ring rings[MAX_RINGS];
uint32_t nextDropMs = 0;
uint16_t dropCount = 0;

// ---------- rain ----------

int8_t walk = -WALK_LIMIT;  // starts calm
uint8_t rain = 0;           // 0 (calm) ~ 255 (downpour)
uint32_t nextWalkMs = 0;

void updateRain(uint32_t now) {
    if ((int32_t)(now - nextWalkMs) < 0) {
        return;
    }
    nextWalkMs = now + WALK_MS;
    walk += (int8_t)random(-WALK_STEP, WALK_STEP + 1);
    // bounce back from the ends
    if (walk > WALK_LIMIT) {
        walk = 2 * WALK_LIMIT - walk;
    }
    if (walk < -WALK_LIMIT) {
        walk = -2 * WALK_LIMIT - walk;
    }
    float sigmoid = 1.0f / (1.0f + expf(-walk / SIGMOID_SCALE));
    rain = (uint8_t)(sigmoid * 255.0f + 0.5f);
}

// calm value at rain 0, pour value at rain 255
int16_t byRain(int16_t calm, int16_t pour) {
    return (int16_t)(calm + ((int32_t)pour - calm) * rain / 255);
}

// cost of a ring per px of growth, 1/100 ms: its average radius is half the fade radius
int32_t ringCost(int16_t fadeRadius) {
    return 100 + 12L * fadeRadius;
}

Color levelColor(uint8_t index, uint8_t level) {
    const Rgb &rgb = PALETTE[index];
    return ScreenColor::color((uint8_t)((uint16_t)rgb.r * level / LEVELS),
                         (uint8_t)((uint16_t)rgb.g * level / LEVELS),
                         (uint8_t)((uint16_t)rgb.b * level / LEVELS));
}

// brightness at a radius: firstLevel at 0, 0 at the fade radius
uint8_t levelAt(const Ring &ring, int16_t radius) {
    if (radius >= ring.fadeRadius) {
        return 0;
    }
    return (uint8_t)((uint16_t)ring.firstLevel * (ring.fadeRadius - radius) / ring.fadeRadius);
}

// ---------- strip: from the old ring to the new one ----------

// a pixel (u, v) from the center is inside the circle of radius r if u^2 + v^2 <= r^2 + r
// (the same rule as drawFilledCircleRadius)
int32_t circleLimit(int16_t r) {
    return r >= 0 ? (int32_t)r * r + r : -1;
}

// largest u >= 0 with u^2 + vSquare <= limit (-1 if none), lowered from the last answer:
// v only grows, so u only shrinks
int16_t shrink(int16_t u, int32_t vSquare, int32_t limit) {
    while (u >= 0 && (int32_t)u * u + vSquare > limit) {
        u--;
    }
    return u;
}

// what one run looks like: u <= blackEnd is black, the rest is color
struct Run {
    int16_t start;
    int16_t end;
    int16_t blackEnd;
    Color color;
};

// the run on a line of the screen: fixed at `line` (a row or a column, by `horizontal`),
// u = start ~ end placed from `origin` toward + (outward = true when + is away from the center)
// or toward - ; clipped here, so nothing off the screen is ever sent
void sendRun(const Run &run, bool horizontal, int16_t line, int16_t origin, int8_t direction) {
    if (line < 0 || line >= SIZE) {
        return;
    }
    // u range on the screen: origin + direction * u in 0 ~ SIZE - 1
    int16_t first = run.start;
    int16_t last = run.end;
    if (direction > 0) {
        first = max(first, (int16_t)(-origin));
        last = min(last, (int16_t)(SIZE - 1 - origin));
    } else {
        first = max(first, (int16_t)(origin - (SIZE - 1)));
        last = min(last, origin);
    }
    if (first > last) {
        return;
    }
    // the window from the lower screen position to the higher one
    int16_t low = direction > 0 ? origin + first : origin - last;
    int16_t high = direction > 0 ? origin + last : origin - first;
    if (horizontal) {
        screen.setWindow(low, line, high, line);
    } else {
        screen.setWindow(line, low, line, high);
    }
    // u <= blackEnd is black: toward the center, so first when u grows with the position
    int16_t count = last - first + 1;
    int16_t blackCount = constrain(run.blackEnd - first + 1, 0, count);
    int16_t colorCount = count - blackCount;
    Color firstColor = direction > 0 ? ScreenColor::BLACK : run.color;
    Color secondColor = direction > 0 ? run.color : ScreenColor::BLACK;
    int16_t firstCount = direction > 0 ? blackCount : colorCount;
    int16_t secondCount = count - firstCount;
    while (firstCount--) {
        screen.writePixel(firstColor);
    }
    while (secondCount--) {
        screen.writePixel(secondColor);
    }
    screen.endWrite();
}

// the ring of outer radius oldRadius (width BORDER) moves to newRadius (>= oldRadius) in color:
// the strip from the old inner edge to the new outer edge, black inside the new ring
void moveRing(int16_t cx, int16_t cy, int16_t oldRadius, int16_t newRadius, Color color) {
    int32_t outerLimit = circleLimit(newRadius);
    int32_t innerLimit = circleLimit(oldRadius - BORDER);   // not sent: inside the old ring
    int32_t blackLimit = circleLimit(newRadius - BORDER);   // sent black
    int16_t outerU = newRadius;
    int16_t innerU = oldRadius - BORDER;
    int16_t blackU = newRadius - BORDER;
    // one octant: u <= v; the other 7 are mirrors
    for (int16_t v = 0; v <= newRadius; v++) {
        int32_t vSquare = (int32_t)v * v;
        outerU = shrink(outerU, vSquare, outerLimit);
        innerU = shrink(innerU, vSquare, innerLimit);
        blackU = shrink(blackU, vSquare, blackLimit);
        Run run = { (int16_t)(innerU + 1), min(v, outerU), blackU, color };
        if (run.start > run.end) {
            continue;
        }
        // top / bottom: rows, u along x; sides: columns, u along y
        sendRun(run, true, cy - v, cx, 1);
        sendRun(run, true, cy - v, cx, -1);
        sendRun(run, true, cy + v, cx, 1);
        sendRun(run, true, cy + v, cx, -1);
        sendRun(run, false, cx + v, cy, 1);
        sendRun(run, false, cx + v, cy, -1);
        sendRun(run, false, cx - v, cy, 1);
        sendRun(run, false, cx - v, cy, -1);
    }
}

// ---------- caption: "No. {drops}" at the bottom left, drawn over the rings ----------

constexpr int16_t CAPTION_Y = SIZE - 27;
constexpr Color CAPTION_COLOR = ScreenColor::color(CAPTION_GRAY[0], CAPTION_GRAY[1], CAPTION_GRAY[2]);

char caption[12] = "";
int16_t captionEnd = CAPTION_X;   // x after the caption
bool captionDirty = false;        // a ring was drawn over it

void setCaption(uint16_t number) {
    screen.drawTexts(CAPTION_X, CAPTION_Y, ScreenColor::BLACK, caption);
    snprintf(caption, sizeof(caption), "No. %u", number);
    captionDirty = true;
}

// true if the strip between the radii inner ~ outer may touch the caption
bool touchesCaption(int16_t cx, int16_t cy, int16_t inner, int16_t outer) {
    // nearest and farthest point of the caption box from the center
    int16_t boxRight = captionEnd;
    int16_t boxBottom = CAPTION_Y + Font::gridHeight;
    int32_t nearX = cx < CAPTION_X ? CAPTION_X - cx : (cx > boxRight ? cx - boxRight : 0);
    int32_t nearY = cy < CAPTION_Y ? CAPTION_Y - cy : (cy > boxBottom ? cy - boxBottom : 0);
    int32_t farX = max(abs(cx - CAPTION_X), abs(cx - boxRight));
    int32_t farY = max(abs(cy - CAPTION_Y), abs(cy - boxBottom));
    int32_t outerSquare = (int32_t)(outer + 1) * (outer + 1);
    int32_t innerSquare = inner > 0 ? (int32_t)inner * inner : 0;
    return nearX * nearX + nearY * nearY <= outerSquare && farX * farX + farY * farY >= innerSquare;
}

void showCaption() {
    if (!captionDirty) {
        return;
    }
    captionEnd = screen.drawTexts(CAPTION_X, CAPTION_Y, CAPTION_COLOR, caption);
    captionDirty = false;
}

// ---------- drops ----------

void startDrop(uint32_t now) {
    // rings: fewer and smaller the more it rains
    int16_t fadeRadius = byRain(CALM_FADE_RADIUS, POUR_FADE_RADIUS);
    uint8_t count = random(255) < rain ? 1 : RING_COUNTS[random(sizeof(RING_COUNTS))];
    // free slots and the budget left
    uint8_t free = 0;
    int32_t used = 0;
    for (uint8_t i = 0; i < MAX_RINGS; i++) {
        if (rings[i].active) {
            used += ringCost(rings[i].fadeRadius);
        } else {
            free++;
        }
    }
    count = min(count, free);
    while (count > 0 && used + count * ringCost(fadeRadius) > BUDGET) {
        count--;
    }
    if (count == 0) {
        return;
    }
    int16_t cx = (int16_t)random(DROP_MARGIN, SIZE - DROP_MARGIN);
    int16_t cy = (int16_t)random(DROP_MARGIN, SIZE - DROP_MARGIN);
    uint8_t color = (uint8_t)random(PALETTE_SIZE);
    uint32_t startMs = now;
    uint8_t made = 0;
    for (uint8_t i = 0; i < MAX_RINGS && made < count; i++) {
        if (rings[i].active) {
            continue;
        }
        rings[i] = { true, cx, cy, startMs, color, (uint8_t)(LEVELS - made * LEVELS / 3), fadeRadius, 0 };
        startMs += (uint32_t)random(RING_GAP_MIN_MS, RING_GAP_MAX_MS);
        made++;
    }
    screen.drawFilledCircleRadius(cx, cy, byRain(CALM_DROP_RADIUS, POUR_DROP_RADIUS), levelColor(color, LEVELS));
    dropCount++;
    setCaption(dropCount);
}

void updateRing(Ring &ring, uint32_t now) {
    if ((int32_t)(now - ring.startMs) < 0) {
        return;
    }
    int16_t radius = (int16_t)((now - ring.startMs) * SPEED / 1000);
    uint8_t level = levelAt(ring, radius);
    if (level == 0) {
        // faded out: the last ring sent black
        radius = ring.radius;
        ring.active = false;
    } else if (radius == ring.radius) {
        return;
    }
    moveRing(ring.cx, ring.cy, ring.radius, radius, level == 0 ? ScreenColor::BLACK : levelColor(ring.color, level));
    if (touchesCaption(ring.cx, ring.cy, ring.radius - BORDER, radius)) {
        captionDirty = true;
    }
    ring.radius = radius;
}

// ---------- main ----------

void setup() {
    screen.init();
    screen.drawFilledScreen(ScreenColor::BLACK);
    screen.setFont<Font>();
    randomSeed(analogRead(A0));
}

void loop() {
    uint32_t now = millis();
    updateRain(now);
    if ((int32_t)(now - nextDropMs) >= 0) {
        startDrop(now);
        nextDropMs = now + (uint32_t)random(byRain(CALM_DROP_MIN_MS, POUR_DROP_MIN_MS),
                                            byRain(CALM_DROP_MAX_MS, POUR_DROP_MAX_MS));
    }
    for (uint8_t i = 0; i < MAX_RINGS; i++) {
        if (rings[i].active) {
            updateRing(rings[i], now);
        }
    }
    showCaption();
}
