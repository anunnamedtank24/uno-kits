#include <Arduino.h>
#include "Uno_I2C.h"
#include "Uno_interrupt_pin.h"
#include "Uno_tone.h"
#include "SSD1306.h"
#include "graphics.h"
#include "image.h"
#include "NEC.h"
#include "buzzer.h"
#include "audio.h"

// UNO + 128x64 I2C OLED + infrared receiver + passive buzzer: write a tune of half notes, then hear it
//   OLED:     GND -> GND, VCC -> 5V, SCL -> D13, SDA -> D11
//   receiver: OUT (S) -> D2, GND (-) -> GND, VCC (+) -> 5V
//   buzzer:   + -> 100 Ω -> D9, - -> GND
//
// a treble staff with NOTE_COUNT half notes, from middle C (C4) up to B4; the triangle marks the note being written
//   UP / DOWN   one step up / down (C D E F G A B), the accidental is dropped
//   *           flat  (♭ in front of the note); on a sharp note: back to natural
//   #           sharp (♯ in front of the note); on a flat note: back to natural
//   OK          the next note; on the last one: play them all (BPM, a half note = 2 beats), then write again
using Remote = NEC::Remote17KeyNumbersTop;   // or Remote17KeyArrowsTop: see src/week_5/test_1.cpp
constexpr uint8_t NOTE_COUNT = 7;                    // 7 fit: an accidental needs room before its note
constexpr uint8_t BPM = 120;                        // a half note = 1 s
constexpr uint16_t GAP_MS = 60;                     // silence at the end of each note: two equal notes stay two
constexpr uint8_t REPEAT_DELAY = 3;                 // repeat codes skipped before a held UP / DOWN repeats

using Bus = Uno::UnoI2C<13, 11>;
using Screen = graphics::Canvas<SSD1306::OLED128x64<Bus>>;
using IrPin = Uno::UnoInterruptPin<2>;
using Receiver = NEC::HX1838<IrPin>;
using Speaker = buzzer::PassiveBuzzer2Pins<Uno::UnoTone<9>>;
using Clef = picture::treble_clef_uno_15x40_palette_2;
Screen screen;
audio::Player<Speaker> speaker;

constexpr uint16_t ON = 1;

// ---------- staff ----------

constexpr int16_t LINE_TOP = 14;                    // y of the top line (F5)
constexpr int16_t SPACING = 6;                      // px between lines: a step (line -> space) is half of it
constexpr int16_t LINE_BOTTOM = LINE_TOP + 4 * SPACING;   // E4
constexpr int16_t CLEF_X = 0;
constexpr int16_t CLEF_Y = LINE_BOTTOM - SPACING - 25;    // the curl (row 25 of the picture) on the G4 line
constexpr int16_t FIRST_X = 26;                     // center of the first note head
constexpr int16_t SLOT = 16;                        // px from one note to the next
constexpr int16_t STEM = 17;                        // px above the head's center
constexpr int16_t CURSOR_Y = 51;                    // top of the triangle under the note

static_assert(FIRST_X + (NOTE_COUNT - 1) * SLOT + 3 < 128, "NOTE_COUNT notes do not fit the screen");

// step 0 ~ 6 = C4 ~ B4; accidental -1 = flat, 0 = natural, 1 = sharp
struct Note {
    uint8_t step;
    int8_t accidental;
};

Note notes[NOTE_COUNT];
uint8_t cursor = 0;

// y of a step: E4 (2) on the bottom line, every step half a spacing higher
int16_t stepY(uint8_t step) {
    return LINE_BOTTOM - (int16_t)(step - 2) * SPACING / 2;
}

int16_t noteX(uint8_t index) {
    return FIRST_X + index * SLOT;
}

// ---------- sound ----------

uint16_t noteHz(const Note &note) {
    static constexpr uint8_t SEMITONES[7] = {0, 2, 4, 5, 7, 9, 11};   // C D E F G A B
    int8_t semitone = (int8_t)(SEMITONES[note.step] + note.accidental);
    if (semitone < 0) {
        return audio::noteHz(audio::B, 3);         // C flat 4 = B3
    }
    if (semitone > 11) {
        return audio::noteHz(audio::C, 5);         // B sharp 4 = C5
    }
    return audio::noteHz((audio::Pitch)semitone, 4);
}

// ---------- drawing ----------

// rows of a small glyph, the leftmost pixel = the highest bit used (WIDTH bits)
template <uint8_t WIDTH, uint8_t HEIGHT>
void drawGlyph(int16_t x, int16_t y, const uint8_t (&rows)[HEIGHT]) {
    for (uint8_t row = 0; row < HEIGHT; row++) {
        for (uint8_t column = 0; column < WIDTH; column++) {
            if (rows[row] & (1 << (WIDTH - 1 - column))) {
                screen.drawPoint(x + column, y + row, ON);
            }
        }
    }
}

// a hollow head 7 x 5 around (cx, cy) and its stem up on the right
void drawHalfNote(int16_t cx, int16_t cy) {
    static constexpr uint8_t HEAD[5] = {
        0b0011100,
        0b0100010,
        0b1000001,
        0b0100010,
        0b0011100,
    };
    drawGlyph<7, 5>(cx - 3, cy - 2, HEAD);
    screen.drawVLinePoints(cx + 3, cy, cy - STEM, ON);
}

// ♯ 5 x 6 or ♭ 4 x 8, its right edge 2 px left of the head
void drawAccidental(int16_t cx, int16_t cy, int8_t accidental) {
    static constexpr uint8_t SHARP[6] = {
        0b01010,
        0b11111,
        0b01010,
        0b01010,
        0b11111,
        0b01010,
    };
    static constexpr uint8_t FLAT[8] = {
        0b1000,
        0b1000,
        0b1000,
        0b1110,
        0b1001,
        0b1001,
        0b1010,
        0b1100,
    };
    if (accidental > 0) {
        drawGlyph<5, 6>(cx - 10, cy - 3, SHARP);
    } else if (accidental < 0) {
        drawGlyph<4, 8>(cx - 9, cy - 5, FLAT);    // the bowl around the note's line / space
    }
}

void drawNote(uint8_t index) {
    const Note &note = notes[index];
    int16_t cx = noteX(index);
    int16_t cy = stepY(note.step);
    if (note.step == 0) {
        // middle C sits on a short line of its own under the staff
        screen.drawHLineCenter(cx, cy, 9, ON);
    }
    drawHalfNote(cx, cy);
    drawAccidental(cx, cy, note.accidental);
}

// the whole screen: staff, clef, notes, the triangle under the note `marked`
void draw(uint8_t marked) {
    screen.clear();
    // the clef first: the picture paints its dark pixels too, the lines then cross it
    image::FlashImage<Screen> pictures(screen);
    pictures.draw<Clef>(CLEF_X, CLEF_Y);
    for (uint8_t line = 0; line < 5; line++) {
        screen.drawHLineSize(0, LINE_TOP + line * SPACING, screen.width(), ON);
    }
    for (uint8_t i = 0; i < NOTE_COUNT; i++) {
        drawNote(i);
    }
    screen.drawFilledTriangleSize(noteX(marked) - 3, CURSOR_Y, 7, 5, ON);
    screen.display();
}

// ---------- playing ----------

// plays every note, moving the triangle along; keys pressed meanwhile are dropped
void playAll() {
    uint16_t noteMs = audio::beatMs(BPM, 2);
    uint32_t startMs = millis();
    for (uint8_t i = 0; i < NOTE_COUNT; i++) {
        // the tone runs on Timer1 while the screen is sent (64 ms)
        speaker.beep(noteHz(notes[i]), noteMs - GAP_MS);
        draw(i);
        uint32_t nextMs = startMs + (uint32_t)(i + 1) * noteMs;
        while ((int32_t)(millis() - nextMs) < 0) {
            speaker.update();
        }
    }
    speaker.stop();
    Receiver::clear();
}

// ---------- keys ----------

// returns true if the screen must be drawn again
bool apply(NEC::Key key, bool repeat) {
    Note &note = notes[cursor];
    switch (key) {
    case NEC::KEY_UP:
        if (note.step < 6) {
            note.step++;
            note.accidental = 0;
            return true;
        }
        return false;
    case NEC::KEY_DOWN:
        if (note.step > 0) {
            note.step--;
            note.accidental = 0;
            return true;
        }
        return false;
    case NEC::KEY_STAR:
        if (repeat || note.accidental < 0) {
            return false;
        }
        note.accidental = note.accidental > 0 ? 0 : -1;
        return true;
    case NEC::KEY_HASH:
        if (repeat || note.accidental > 0) {
            return false;
        }
        note.accidental = note.accidental < 0 ? 0 : 1;
        return true;
    case NEC::KEY_OK:
        if (repeat) {
            return false;
        }
        if (cursor + 1 < NOTE_COUNT) {
            cursor++;
            return true;
        }
        playAll();
        cursor = 0;
        return true;
    default:
        return false;
    }
}

void setup() {
    if (!screen.init()) {
        // no answer at 0x3C: check the wiring (see src/week_4/README.md)
        while (true) {
        }
    }
    speaker.init();
    speaker.setVolume(1);
    Receiver::init();
    for (uint8_t i = 0; i < NOTE_COUNT; i++) {
        notes[i] = {0, 0};                          // all middle C
    }
    draw(cursor);
}

void loop() {
    NEC::Code code;
    bool changed = false;
    while (Receiver::read(code, REPEAT_DELAY)) {
        if (apply(Remote::toKey(code), code.repeats > 0)) {
            changed = true;
        }
    }
    if (changed) {
        draw(cursor);
    }
}
