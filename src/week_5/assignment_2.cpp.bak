#include <Arduino.h>
#include "Uno_I2C.h"
#include "Uno_interrupt_pin.h"
#include "SSD1306.h"
#include "graphics.h"
#include "NEC.h"

// UNO + 128x64 I2C OLED + infrared receiver: the arrows of the remote move a small square 1 pixel
//   OLED:     GND -> GND, VCC -> 5V, SCL -> D13, SDA -> D11
//   receiver: OUT (S) -> D2, GND (-) -> GND, VCC (+) -> 5V
//
// a press moves it 1 pixel; holding keeps moving (after ~0.3 s, ~9 pixels a second); it stops at the edges
// OK puts it back in the middle
using Remote = NEC::Remote17KeyNumbersTop;   // or Remote17KeyArrowsTop: see src/week_5/test_1.cpp
constexpr int16_t SIZE = 6;                         // px
constexpr uint8_t REPEAT_DELAY = 3;                 // repeat codes skipped before a held key repeats

using Bus = Uno::UnoI2C<13, 11>;
using Screen = graphics::Canvas<SSD1306::OLED128x64<Bus>>;
using IrPin = Uno::UnoInterruptPin<2>;
using Receiver = NEC::HX1838<IrPin>;
Screen screen;

constexpr uint16_t ON = 1;
constexpr uint16_t OFF = 0;
constexpr int16_t START_X = (128 - SIZE) / 2;
constexpr int16_t START_Y = (64 - SIZE) / 2;

int16_t squareX = START_X;
int16_t squareY = START_Y;

// the new top-left corner of the square for a key; false if the key does not move it
bool move(NEC::Key key, int16_t &x, int16_t &y) {
    x = squareX;
    y = squareY;
    switch (key) {
    case NEC::KEY_UP:
        y--;
        break;
    case NEC::KEY_DOWN:
        y++;
        break;
    case NEC::KEY_LEFT:
        x--;
        break;
    case NEC::KEY_RIGHT:
        x++;
        break;
    case NEC::KEY_OK:
        x = START_X;
        y = START_Y;
        break;
    default:
        return false;
    }
    x = constrain(x, (int16_t)0, (int16_t)(screen.width() - SIZE));
    y = constrain(y, (int16_t)0, (int16_t)(screen.height() - SIZE));
    return x != squareX || y != squareY;
}

void setup() {
    if (!screen.init()) {
        // no answer at 0x3C: check the wiring (see src/week_4/README.md)
        while (true) {
        }
    }
    Receiver::init();
    screen.drawFilledRectSize(squareX, squareY, SIZE, SIZE, ON);
    screen.display();
}

void loop() {
    NEC::Code code;
    bool moved = false;
    while (Receiver::read(code, REPEAT_DELAY)) {
        NEC::Key key = Remote::toKey(code);
        if (key == NEC::KEY_OK && code.repeats > 0) {
            continue;
        }
        int16_t x;
        int16_t y;
        if (move(key, x, y)) {
            // erase the old square, draw the new one: display() sends only the changed bytes
            screen.drawFilledRectSize(squareX, squareY, SIZE, SIZE, OFF);
            squareX = x;
            squareY = y;
            screen.drawFilledRectSize(squareX, squareY, SIZE, SIZE, ON);
            moved = true;
        }
    }
    if (moved) {
        screen.display();
    }
}
