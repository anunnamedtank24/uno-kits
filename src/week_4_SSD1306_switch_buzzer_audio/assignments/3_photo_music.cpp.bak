#include <Arduino.h>
#include "Uno_I2C.h"
#include "Uno_tone.h"
#include "SSD1306.h"
#include "image.h"
#include "buzzer.h"
#include "audio.h"
#include "color.h"

// UNO + 128x64 I2C OLED + passive buzzer: a slide show, every photo with its own music
//
// slide n shows photos[n] and plays songs[n]; when the song has ended (and the photo was up for
// at least MIN_SLIDE_MS) it waits PAUSE_MS, then the next slide; after the last one, the first again
//
// the photos are black / white (the OLED has no colors), made by lib/image/source/convert.py
// (see src/week_4_SSD1306_switch_buzzer_audio/assignments/1_photo_switch.cpp); the songs are made by lib/audio/source/convert.py
// the song plays on Timer1 while the screen is sent (display() ~64 ms only when the photo changes)

// ---------- settings ----------

// wiring: OLED VCC -> 5V, GND -> GND
constexpr uint8_t SCL_PIN = 13;             // SCL: any pin (I2C made by the program)
constexpr uint8_t SDA_PIN = 11;             // SDA: any pin
constexpr bool I2C_INTERNAL_PULLUP = true;  // the UNO's ~35 kΩ pull-ups as well (the modules have their own)
constexpr uint16_t I2C_KHZ = 400;           // 1 ~ 400 (really ~160): lower it if the picture breaks up
constexpr bool FLIP = false;                // true: the OLED turned 180° (pins at the bottom)
// wiring: passive buzzer - -> GND (a 3-pin module: see Speaker below)
constexpr uint8_t BUZZER_PIN = 9;           // + (through 100 Ω); any pin, D9 / D10 are driven by Timer1 itself

constexpr uint8_t VOLUME = 1;               // 0 = silent ~ 255 = the loudest; 128 = -6 dB, 64 = -12 dB
constexpr uint8_t GAP_MS = 20;              // silence between two notes
constexpr uint16_t MIN_SLIDE_MS = 2000;     // a short jingle still leaves the photo up this long
constexpr uint16_t PAUSE_MS = 800;          // silence between two slides
constexpr uint8_t BW_THRESHOLD = 128;       // a picture's color lights a dot from this brightness on (0 ~ 255)

// ---------- parts ----------

using Bus = Uno::UnoI2C<SCL_PIN, SDA_PIN, I2C_INTERNAL_PULLUP, I2C_KHZ>;
using ScreenColor = color::BW<BW_THRESHOLD>;       // the OLED: dots on / off
using Screen = SSD1306::OLED128x64<Bus, ScreenColor>;
using Speaker = buzzer::PassiveBuzzer2Pins<Uno::UnoTone<BUZZER_PIN>>;   // 3-pin module: PassiveBuzzer3Pins<Uno::UnoTone<BUZZER_PIN, true>>
Screen screen;
audio::Player<Speaker, GAP_MS> speaker;

// ---------- slides ----------

template <class Picture>
void drawPicture() {
    image::FlashImage<Screen> pictures(screen);
    pictures.draw<Picture>(0, 0);
}

template <class Melody>
void playSong() {
    speaker.play<Melody>();
}

// one photo and one song a slide, in the same order
void (*const photos[])() = {
    drawPicture<picture::sunset_flash_128x64_palette_2>,
    drawPicture<picture::moon_flash_128x64_palette_2>,
    drawPicture<picture::city_flash_128x64_palette_2>,
    drawPicture<picture::logo_flash_stream_128x64_palette_2>,
};
void (*const songs[])() = {
    playSong<melody::twinkle_star_flash_passive_medium>,   // 6.4 s
    playSong<melody::ode_to_joy_flash_passive_medium>,     // 6.9 s
    playSong<melody::scale_flash_passive_medium>,          // 4.3 s
    playSong<melody::startup_flash_passive_medium>,        // 0.5 s (the photo stays MIN_SLIDE_MS)
};
constexpr uint8_t SLIDE_COUNT = sizeof(photos) / sizeof(photos[0]);
static_assert(sizeof(songs) / sizeof(songs[0]) == SLIDE_COUNT, "one song for every photo");

uint8_t slide = 0;
uint32_t slideStartMs = 0;
uint32_t songEndMs = 0;            // 0 while the song is playing

void showSlide() {
    screen.clear();
    photos[slide]();
    screen.display();
    songs[slide]();
    slideStartMs = millis();
    songEndMs = 0;
}

// ---------- main ----------

// nothing answered at 0x3C: stop (the built-in LED is on SCL, it cannot blink)
void halt() {
    while (true) {
    }
}

void setup() {
    speaker.init();
    speaker.setVolume(VOLUME);
    if (!screen.init(FLIP)) {
        halt();
    }
    showSlide();
}

void loop() {
    speaker.update();
    uint32_t now = millis();
    if (songEndMs == 0) {
        if (!speaker.isPlaying() && now - slideStartMs >= MIN_SLIDE_MS) {
            songEndMs = now;
        }
        return;
    }
    if (now - songEndMs >= PAUSE_MS) {
        slide = (uint8_t)((slide + 1) % SLIDE_COUNT);
        showSlide();
    }
}
