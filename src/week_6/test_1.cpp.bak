#include <Arduino.h>
#include "Uno_serial.h"
#include "Uno_pin.h"
#include "Uno_interrupt_pin.h"
#include "ultrasonic.h"

// UNO + HC-SR04 ultrasonic distance module: every measurement goes to the USB serial
//   HC-SR04: VCC -> 5V, Trig -> D7, Echo -> D8, GND -> GND
//   pio device monitor        (platformio.ini: monitor_speed = 1000000)
//
// a line every MEASURE_MS:  " 23.4 cm  echo  1364 us  |###########"   (one # = 2 cm, up to BAR_CM)
// or what went wrong:       "too near (< 2 cm)", "too far / nothing (> 400 cm)",
//                           "no echo: check VCC / GND, Trig on D7, Echo on D8 (not swapped)",
//                           "busy: Echo still HIGH from the last one"
// Echo is on D8 so D2 stays free for the infrared receiver (one interrupt pin per group: D0 ~ D7, D8 ~ D13)
using Trigger = Uno::UnoOutputPin<7>;
using Echo = Uno::UnoInterruptPin<8>;
using Ranger = ultrasonic::HCSR04<Trigger, Echo>;
using Link = Uno::UnoSerial<1000000>;

constexpr uint16_t MEASURE_MS = 200;      // 60 ~ : how often (slower than the 60 ms minimum, to read the lines)
constexpr int16_t AIR_TENTHS_C = 250;     // the room's temperature, 0.1 °C: 250 = 25.0 °C
constexpr uint16_t BAR_CM = 100;          // the bar ends here
constexpr uint8_t BAR_CM_PER_CHAR = 2;

// ---------- text over the serial link ----------

void printText(const char *text) {
    while (*text) {
        Link::write8((uint8_t)*text);
        text++;
    }
}

// right-aligned in width characters
void printNumber(uint32_t value, uint8_t width = 0) {
    char digits[11];
    uint8_t i = sizeof(digits) - 1;
    digits[i] = '\0';
    do {
        i--;
        digits[i] = (char)('0' + value % 10);
        value /= 10;
    } while (value > 0);
    for (uint8_t n = (uint8_t)(sizeof(digits) - 1 - i); n < width; n++) {
        printText(" ");
    }
    printText(&digits[i]);
}

// ---------- test ----------

void printDistance() {
    uint16_t mm = Ranger::distanceMm();
    printNumber(mm / 10, 3);
    printText(".");
    printNumber(mm % 10);
    printText(" cm  echo ");
    printNumber(Ranger::echoUs(), 5);
    printText(" us  |");
    uint16_t cm = mm / 10 > BAR_CM ? BAR_CM : mm / 10;
    for (uint16_t n = 0; n < cm / BAR_CM_PER_CHAR; n++) {
        printText("#");
    }
    printText(mm / 10 > BAR_CM ? ">\r\n" : "\r\n");
}

void setup() {
    Link::init();
    Ranger::init();
    Ranger::setIntervalMs(MEASURE_MS);
    Ranger::setTemperature(AIR_TENTHS_C);
    printText("\r\nHC-SR04: Trig D7, Echo D8; sound at ");
    printNumber(Ranger::soundSpeed() / 10);
    printText(".");
    printNumber(Ranger::soundSpeed() % 10);
    printText(" m/s\r\n");
    printText(Echo::read() ? "Echo idle: HIGH (should be LOW: Trig / Echo swapped?)\r\n" : "Echo idle: LOW (ok)\r\n");
}

void loop() {
    if (!Ranger::update()) {
        return;
    }
    switch (Ranger::result()) {
        case ultrasonic::RESULT_OK:
            printDistance();
            break;
        case ultrasonic::RESULT_TOO_NEAR:
            printText("too near (< 2 cm)\r\n");
            break;
        case ultrasonic::RESULT_TOO_FAR:
            printText("too far / nothing (> 400 cm), or a soft / slanted surface\r\n");
            break;
        case ultrasonic::RESULT_NO_ECHO:
            printText("no echo: check VCC / GND, Trig on D7, Echo on D8 (not swapped)\r\n");
            break;
        case ultrasonic::RESULT_BUSY:
            printText("busy: Echo still HIGH from the last one\r\n");
            break;
        default:
            break;
    }
}
