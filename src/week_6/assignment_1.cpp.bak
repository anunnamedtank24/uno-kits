#include <Arduino.h>
#include "Uno_serial.h"
#include "Uno_pin.h"
#include "Uno_interrupt_pin.h"
#include "Uno_tone.h"
#include "switch.h"
#include "ultrasonic.h"
#include "buzzer.h"

// UNO + switch module + HC-SR04 + passive buzzer: a parking sensor you switch on by hand
//   switch:  GND -> GND, VCC -> 5V, OUT -> D2
//   HC-SR04: VCC -> 5V, Trig -> D7, Echo -> D8, GND -> GND
//   buzzer:  + -> 100 Ω -> D9, - -> GND (passive)
//
// while the switch is pressed and something is nearer than NEAR_MM, the buzzer sounds;
// its volume is inversely proportional to the distance:  volume = 255 × FULL_MM / distance,
// so half the distance = twice the volume, up to 255 (the loudest) at FULL_MM and nearer
//   e.g. FULL_MM 50, NEAR_MM 500:  50 cm -> 26,  25 cm -> 51,  10 cm -> 128,  5 cm and nearer -> 255
// released, nothing near, or no echo: silent
//
// the distance is measured every 60 ms (the HC-SR04's minimum) whether pressed or not,
// so the sound starts at once when the switch is pressed
// the state goes to the USB serial every PRINT_MS: pio device monitor (1 Mbaud)
using Button = switches::Switch3Pins<Uno::UnoPin<2>, false>;   // this module: OUT = LOW while pressed (ACTIVE_HIGH = false)
using Ranger = ultrasonic::HCSR04<Uno::UnoOutputPin<7>, Uno::UnoInterruptPin<8>>;
using Speaker = buzzer::PassiveBuzzer2Pins<Uno::UnoTone<9>>;
using Link = Uno::UnoSerial<1000000>;

constexpr uint16_t NEAR_MM = 100;          // sounds only nearer than this (50 cm)
constexpr uint16_t FULL_MM = 20;           // the loudest from here on (5 cm); FULL_MM < NEAR_MM
constexpr uint8_t MAX_VOLUME = 8;        // 0 ~ 255: the volume at FULL_MM (128 = -6 dB)
constexpr uint16_t TONE_HZ = 2700;         // near the buzzer's resonance: the loudest pitch
constexpr int16_t AIR_TENTHS_C = 250;      // the room's temperature, 0.1 °C
constexpr uint16_t PRINT_MS = 300;

static_assert(FULL_MM > 0 && FULL_MM < NEAR_MM, "FULL_MM must be 1 ~ NEAR_MM - 1");

Button button;
uint8_t volume = 0;                        // from the last measurement: 0 = too far / nothing
bool sounding = false;
uint32_t nextPrintMs = 0;

// ---------- text over the serial link ----------

void printText(const char *text) {
    while (*text) {
        Link::write8((uint8_t)*text);
        text++;
    }
}

void printNumber(uint32_t value) {
    char digits[11];
    uint8_t i = sizeof(digits) - 1;
    digits[i] = '\0';
    do {
        i--;
        digits[i] = (char)('0' + value % 10);
        value /= 10;
    } while (value > 0);
    printText(&digits[i]);
}

// ---------- distance -> volume ----------

// MAX_VOLUME × FULL_MM / mm (rounded), MAX_VOLUME at FULL_MM and nearer, 0 from NEAR_MM on
uint8_t volumeFor(uint16_t mm) {
    if (mm >= NEAR_MM) {
        return 0;
    }
    if (mm <= FULL_MM) {
        return MAX_VOLUME;
    }
    uint32_t v = ((uint32_t)MAX_VOLUME * FULL_MM + mm / 2) / mm;
    return v == 0 ? 1 : (uint8_t)v;
}

void measured() {
    switch (Ranger::result()) {
        case ultrasonic::RESULT_OK:
            volume = volumeFor(Ranger::distanceMm());
            break;
        case ultrasonic::RESULT_TOO_NEAR:          // closer than 2 cm: as near as it gets
            volume = MAX_VOLUME;
            break;
        default:                                   // too far, no echo, busy
            volume = 0;
            break;
    }
}

// ---------- the buzzer ----------

void updateSound() {
    bool on = button.isOn() && volume > 0;
    if (on) {
        if (!sounding) {
            Speaker::setVolume(volume);
            Speaker::start(TONE_HZ);
            sounding = true;
        } else if (Speaker::volume() != volume) {
            Speaker::setVolume(volume);            // while playing, no click
        }
    } else if (sounding) {
        Speaker::stop();
        sounding = false;
    }
}

void printState() {
    printText(button.isOn() ? "pressed   " : "released  ");
    if (Ranger::result() == ultrasonic::RESULT_OK) {
        uint16_t mm = Ranger::distanceMm();
        printNumber(mm / 10);
        printText(".");
        printNumber(mm % 10);
        printText(" cm");
    } else if (Ranger::result() == ultrasonic::RESULT_TOO_NEAR) {
        printText("< 2 cm");
    } else {
        printText("---");
    }
    printText("  volume ");
    printNumber(volume);
    printText(sounding ? "  (sounding)\r\n" : "\r\n");
}

// ---------- main ----------

void setup() {
    Link::init();
    Speaker::init();
    button.init();
    Ranger::init();
    Ranger::setTemperature(AIR_TENTHS_C);
    printText("\r\nhold the switch (D2) and bring something nearer than ");
    printNumber(NEAR_MM / 10);
    printText(" cm to the HC-SR04\r\n");
    nextPrintMs = millis();
}

void loop() {
    button.update();
    if (Ranger::update()) {
        measured();
    }
    updateSound();
    if ((int32_t)(millis() - nextPrintMs) >= 0) {
        nextPrintMs += PRINT_MS;
        printState();
    }
}
