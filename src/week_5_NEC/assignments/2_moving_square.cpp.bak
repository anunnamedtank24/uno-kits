#include <Arduino.h>
#include "Uno_I2C.h"
#include "Uno_interrupt_pin.h"
#include "SSD1306.h"
#include "graphics.h"
#include "NEC.h"
#include "color.h"

// UNO + 128x64 I2C OLED + infrared receiver: the arrows of the remote move a small square 1 pixel
//
// a press moves it 1 pixel; holding keeps moving (after ~0.3 s, ~9 pixels a second); it stops at the edges
// OK puts it back in the middle

// ---------- settings ----------

// wiring: OLED VCC -> 5V, GND -> GND
constexpr uint8_t SCL_PIN = 13;             // SCL: any pin (I2C made by the program)
constexpr uint8_t SDA_PIN = 11;             // SDA: any pin
constexpr bool I2C_INTERNAL_PULLUP = true;  // the UNO's ~35 kΩ pull-ups as well (the modules have their own)
constexpr uint16_t I2C_KHZ = 400;           // 1 ~ 400 (really ~160): lower it if the picture breaks up
constexpr bool FLIP = false;                // true: the OLED turned 180° (pins at the bottom)
// wiring: infrared receiver + -> 5V, - -> GND
constexpr uint8_t IR_PIN = 2;               // S (OUT): any pin (pin-change interrupt)
constexpr uint8_t IR_QUEUE = 4;             // codes kept while the program is busy

using Remote = NEC::Remote17KeyNumbersTop;  // or Remote17KeyArrowsTop: see src/week_5_NEC/tests/1_receiver.cpp
constexpr int16_t SIZE = 6;                 // the square, px
constexpr uint8_t REPEAT_DELAY = 3;         // repeat codes skipped before a held key repeats
constexpr uint8_t BW_THRESHOLD = 128;       // a picture's color lights a dot from this brightness on (0 ~ 255)

// ---------- parts ----------

using Bus = Uno::UnoI2C<SCL_PIN, SDA_PIN, I2C_INTERNAL_PULLUP, I2C_KHZ>;
using ScreenColor = color::BW<BW_THRESHOLD>;       // the OLED: dots on / off
using Screen = graphics::Canvas<SSD1306::OLED128x64<Bus, ScreenColor>>;
using Receiver = NEC::HX1838<Uno::UnoInterruptPin<IR_PIN>, IR_QUEUE>;
Screen screen;

constexpr uint16_t ON = 1;
constexpr uint16_t OFF = 0;
constexpr int16_t START_X = (128 - SIZE) / 2;
constexpr int16_t START_Y = (64 - SIZE) / 2;

int16_t squareX = START_X;
int16_t squareY = START_Y;

// the new top-left corner of the square for a key; false if the key does not move it
bool move(NEC::Key key, int16_t &x, int16_t &y) {
    x = squareX;
    y = squareY;
    switch (key) {
    case NEC::KEY_UP:
        y--;
        break;
    case NEC::KEY_DOWN:
        y++;
        break;
    case NEC::KEY_LEFT:
        x--;
        break;
    case NEC::KEY_RIGHT:
        x++;
        break;
    case NEC::KEY_OK:
        x = START_X;
        y = START_Y;
        break;
    default:
        return false;
    }
    x = constrain(x, (int16_t)0, (int16_t)(screen.width() - SIZE));
    y = constrain(y, (int16_t)0, (int16_t)(screen.height() - SIZE));
    return x != squareX || y != squareY;
}

// ---------- main ----------

void setup() {
    if (!screen.init(FLIP)) {
        // no answer at 0x3C: check the wiring (see src/week_4_SSD1306_switch_buzzer_audio/README.md)
        while (true) {
        }
    }
    Receiver::init();
    screen.drawFilledRectSize(squareX, squareY, SIZE, SIZE, ON);
    screen.display();
}

void loop() {
    NEC::Code code;
    bool moved = false;
    while (Receiver::read(code, REPEAT_DELAY)) {
        NEC::Key key = Remote::toKey(code);
        if (key == NEC::KEY_OK && code.repeats > 0) {
            continue;
        }
        int16_t x;
        int16_t y;
        if (move(key, x, y)) {
            // erase the old square, draw the new one: display() sends only the changed bytes
            screen.drawFilledRectSize(squareX, squareY, SIZE, SIZE, OFF);
            squareX = x;
            squareY = y;
            screen.drawFilledRectSize(squareX, squareY, SIZE, SIZE, ON);
            moved = true;
        }
    }
    if (moved) {
        screen.display();
    }
}
