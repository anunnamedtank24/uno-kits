#include <Arduino.h>
#include "Uno_pin.h"
#include "Uno_interrupt_pin.h"
#include "Uno_serial.h"
#include "NEC.h"
#include "LED.h"

// UNO + infrared receiver + traffic light module (red, green) + one LED (blue): the remote sets R, G, B
//
//   1: R -= 1   2: R = 0   3: R += 1
//   4: G -= 1   5: G = 0   6: G += 1
//   7: B -= 1   8: B = 0   9: B += 1
//   0: R, G, B = 0
// R, G, B are levels 0 ~ LEVELS, shown as brightness the eye sees evenly (LED::toDuty);
// holding 1, 3, 4, 6, 7, 9 keeps stepping (after ~0.3 s, ~9 steps a second)
// every change is also printed to the USB serial: pio device monitor

// ---------- settings ----------

// wiring: infrared receiver + -> 5V, - -> GND
constexpr uint8_t IR_PIN = 2;               // S (OUT): any pin (pin-change interrupt)
constexpr uint8_t IR_QUEUE = 4;             // codes kept while the program is busy
// wiring: traffic light module GND -> GND, Y not connected (the module has its own resistors)
constexpr uint8_t RED_PIN = 3;              // R: a PWM pin (3, 5, 6, 9, 10, 11)
constexpr uint8_t GREEN_PIN = 5;            // G: a PWM pin
// wiring: blue LED short leg (-) -> GND
constexpr uint8_t BLUE_PIN = 6;             // long leg (+) through 220 Ω: a PWM pin
constexpr uint32_t BAUD = 1000000;          // USB serial: the same as monitor_speed in platformio.ini

using Remote = NEC::Remote17KeyNumbersTop;  // or Remote17KeyArrowsTop: see src/week_5_NEC/tests/1_receiver.cpp
constexpr uint8_t LEVELS = 10;              // steps from off to full
constexpr uint8_t REPEAT_DELAY = 3;         // repeat codes skipped before a held key repeats

// ---------- parts ----------

using Receiver = NEC::HX1838<Uno::UnoInterruptPin<IR_PIN>, IR_QUEUE>;
using Link = Uno::UnoSerial<BAUD>;
LED::TrafficLight4Pins<Uno::UnoPwmPin<RED_PIN>, LED::NoPwm, Uno::UnoPwmPin<GREEN_PIN>> trafficLight;   // yellow not used
LED::LED2Pins<Uno::UnoPwmPin<BLUE_PIN>> blue;

uint8_t levels[3] = {0, 0, 0};                      // R, G, B

// ---------- color ----------

void show() {
    trafficLight.setRed(LED::levelToBrightness(levels[0], LEVELS));
    trafficLight.setGreen(LED::levelToBrightness(levels[1], LEVELS));
    blue.set(LED::levelToBrightness(levels[2], LEVELS));
    Link::printText("R ");
    Link::printNumber(levels[0]);
    Link::printText("  G ");
    Link::printNumber(levels[1]);
    Link::printText("  B ");
    Link::printNumber(levels[2]);
    Link::printText("\r\n");
}

// key 1 ~ 9 -> color (0 = R, 1 = G, 2 = B) and action (0: -= 1, 1: = 0, 2: += 1); 0: all off
// returns true if something changed
bool apply(NEC::Key key, bool repeat) {
    int8_t digit = NEC::keyDigit(key);
    if (digit < 0) {
        return false;
    }
    if (digit == 0) {
        if (repeat) {
            return false;
        }
        levels[0] = levels[1] = levels[2] = 0;
        return true;
    }
    uint8_t color = (uint8_t)((digit - 1) / 3);
    uint8_t action = (uint8_t)((digit - 1) % 3);
    uint8_t &level = levels[color];
    if (action == 0 && level > 0) {
        level--;
        return true;
    }
    if (action == 1 && !repeat && level > 0) {
        level = 0;
        return true;
    }
    if (action == 2 && level < LEVELS) {
        level++;
        return true;
    }
    return false;
}

// ---------- main ----------

void setup() {
    Link::init();
    trafficLight.init();
    blue.init();
    Receiver::init();
    Link::printText("\r\nred ");
    Link::printPin(RED_PIN);
    Link::printText(", green ");
    Link::printPin(GREEN_PIN);
    Link::printText(" (traffic light), blue ");
    Link::printPin(BLUE_PIN);
    Link::printText(" (LED), remote on ");
    Link::printPin(IR_PIN);
    Link::printText("\r\n");
    show();
}

void loop() {
    NEC::Code code;
    while (Receiver::read(code, REPEAT_DELAY)) {
        if (apply(Remote::toKey(code), code.repeats > 0)) {
            show();
        }
    }
}
