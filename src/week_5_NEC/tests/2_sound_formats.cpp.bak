#include <Arduino.h>
#include "Uno_serial.h"
#include "Uno_tone.h"
#include "Uno_pcm_out.h"
#include "buzzer.h"
#include "audio.h"
#include "stream.h"

// UNO + passive buzzer: every format of lib/audio, from flash and from the computer
//   on the computer:   python lib/stream/source/stream.py      (it prints what the board reports)
//
// tests, one after another (each line also says what you should hear):
//   0 notes, medium (Hz + ms)          twinkle star, in tune
//   1 notes, low (MIDI + 10 ms)        the same tune, half the bytes
//   2 rhythm (active) on the passive   SOS at its rhythmHz
//   3 PCM from flash, 8 kHz ADPCM      "Hello! I am an Arduino." (the rate is measured)
//   4 notes from the computer               twinkle star again (needs stream.py)
//   5 PCM from the computer, 16 kHz 8 bits  ode to joy as a real sound (underruns are counted)
// then it starts over after AGAIN_MS

// ---------- settings ----------

// wiring: passive buzzer - -> GND
constexpr uint8_t BUZZER_PIN = 9;           // + (through 100 Ω): D9 or D10 for PCM (Timer1 PWM)
constexpr uint32_t BAUD = 1000000;          // USB serial for stream.py (its --baud)

constexpr uint16_t PAUSE_MS = 500;          // between two tests
constexpr uint16_t AGAIN_MS = 3000;         // after the last one
constexpr uint16_t PCM_BUFFER = 512;        // test 5: bytes waiting to be played (256 runs short at 16 kHz)
constexpr uint8_t PCM_CHUNK = 255;          // test 5: bytes per request to stream.py (64 runs short at 16 kHz)
constexpr uint8_t NOTE_CHUNK = 32;          // test 4: bytes per request to stream.py

// ---------- parts ----------

using Link = Uno::UnoSerial<BAUD>;
using NoteLink = stream::Puller<Link, NOTE_CHUNK>;  // asks stream.py for notes
using PcmLink = stream::Puller<Link, PCM_CHUNK>;    // and for samples, in bigger pieces
using Speaker = buzzer::PassiveBuzzer2Pins<Uno::UnoTone<BUZZER_PIN>>;
using PcmOut = Uno::UnoPcmOut<BUZZER_PIN>;
using Samples = audio::SamplePlayer<PcmOut>;
using StreamSamples = audio::StreamSamplePlayer<PcmOut, PcmLink, PCM_BUFFER>;

audio::Player<Speaker> speaker;
audio::StreamPlayer<Speaker, NoteLink> streamSpeaker;

// ---------- reports (printed by stream.py) ----------

char line[96];
uint8_t lineLength = 0;

void add(const char *text) {
    while (*text && lineLength < sizeof(line) - 1) {
        line[lineLength++] = *text++;
    }
    line[lineLength] = '\0';
}

void addNumber(uint32_t value) {
    char digits[11];
    uint8_t i = sizeof(digits) - 1;
    digits[i] = '\0';
    do {
        i--;
        digits[i] = (char)('0' + value % 10);
        value /= 10;
    } while (value > 0);
    add(&digits[i]);
}

void send() {
    NoteLink::message(line);
    lineLength = 0;
    line[0] = '\0';
}

// ---------- tests ----------

template <class Melody>
void playNotes(const char *what) {
    add(what);
    send();
    speaker.play<Melody>();
    while (speaker.isPlaying()) {
        speaker.update();
    }
}

void testFlashPcm() {
    add("3 PCM flash, 8 kHz ADPCM: hello");
    send();
    Samples::play<melody::hello_flash_pcm_8000_adpcm>();
    uint32_t startMs = millis();
    uint32_t afterSecond = 0;
    uint16_t realRate = PcmOut::realRate();
    while (Samples::isPlaying()) {
        Samples::update();
        if (afterSecond == 0 && millis() - startMs >= 1000) {
            afterSecond = Samples::position();
        }
    }
    uint32_t ms = millis() - startMs;
    add("   realRate ");
    addNumber(realRate);
    add(" Hz, ");
    addNumber(afterSecond);
    add(" samples in the first 1000 ms, all ");
    addNumber(Samples::position());
    add(" in ");
    addNumber(ms);
    add(" ms");
    send();
}

void testStreamNotes() {
    add("4 notes from the computer: twinkle star");
    send();
    uint8_t result = streamSpeaker.open<melody::twinkle_star_stream_passive_medium>();
    if (result != streamSpeaker.OK) {
        add("   open failed: error ");
        addNumber(result);
        send();
        return;
    }
    uint32_t startMs = millis();
    while (streamSpeaker.isPlaying()) {
        streamSpeaker.update();
    }
    add("   ");
    addNumber(streamSpeaker.noteIndex());
    add(" steps in ");
    addNumber(millis() - startMs);
    add(" ms, error ");
    addNumber(streamSpeaker.error());
    send();
}

void testStreamPcm() {
    add("5 PCM from the computer, 16 kHz 8 bits: ode to joy");
    send();
    uint32_t startMs = millis();
    uint8_t result = StreamSamples::open<melody::ode_to_joy_stream_pcm_16000_u8>();
    if (result != StreamSamples::OK) {
        add("   open failed: error ");
        addNumber(result);
        send();
        return;
    }
    uint32_t playMs = millis();
    while (StreamSamples::isPlaying()) {
        StreamSamples::update();
    }
    uint32_t endMs = millis();
    add("   opened in ");
    addNumber(playMs - startMs);
    add(" ms; ");
    addNumber(StreamSamples::position());
    add(" samples in ");
    addNumber(endMs - playMs);
    add(" ms, underruns ");
    addNumber(StreamSamples::underruns());
    add(", error ");
    addNumber(StreamSamples::error());
    send();
}

// ---------- main ----------

void setup() {
    Link::init();
    speaker.init();
    Samples::init();
    delay(PAUSE_MS);
}

void loop() {
    playNotes<melody::twinkle_star_flash_passive_medium>("0 notes medium: twinkle star");
    delay(PAUSE_MS);
    playNotes<melody::twinkle_star_flash_passive_low>("1 notes low (compact): twinkle star");
    delay(PAUSE_MS);
    playNotes<melody::sos_flash_active_medium>("2 rhythm on the passive buzzer: SOS");
    delay(PAUSE_MS);
    testFlashPcm();
    speaker.init();
    delay(PAUSE_MS);
    testStreamNotes();
    delay(PAUSE_MS);
    testStreamPcm();
    speaker.init();
    add("done, again soon");
    send();
    delay(AGAIN_MS);
}
