#include <Arduino.h>
#include <string.h>
#include "Uno_ST7789.h"
#include "Uno_one_wire.h"
#include "ST7789.h"
#include "graphics.h"
#include "color.h"
#include "font.h"
#include "DS18B20.h"

// UNO + M130T + DS18B20: temperature, raw value and the screen's frame rate
//   M130T:   SCL -> D13, SDA -> D11, DC -> D8, RES -> D10, BLK -> D9
//   DS18B20: VCC -> 5V, DQ -> D2, GND -> GND (DQ needs a 4.7 kΩ pull-up, most modules have one)
//
// screen:
//   Temp: 23.5\circ C   or  Temp: no sensor   ("\circ" as 5 plain chars)
//   Raw: 376           or  Raw: no sensor   (within a frame of pulling DQ out)
//   FPS: 85.3
// only the numbers are colored, by the change since the last value (temperature and raw: the same change):
//   the same = gray-white, rising = mixed toward red, falling = toward blue
//   steps = |change| / unit; the share of red / blue doubles per step: 1/16, 1/8, 1/4, 1/2, all (5 steps)
//   every color has the brightness VALUE_LUMA (0.299 R + 0.587 G + 0.114 B), and so has every mix:
//   only the hue changes, never the brightness; labels and the unit use the dimmer LABEL_LUMA
using Bus = Uno::UnoST7789<8, 10, Uno::NONE, 9>;
using Screen = graphics::Canvas<ST7789::M130T<Bus>>;
using SensorWire = Uno::UnoOneWire<2>;
using Sensor = DS18B20::Thermometer<SensorWire>;
namespace RGB565 = color::RGB565;
using Font = font::menlo_width_12_first_32_last_126_default_63; // 12 x 35, ASCII 32 ~ 126

Screen screen;
Sensor sensor;

// one step of change for the colors, decimals allowed (worked out at compile time, no float at run time)
constexpr float TEMP_UNIT = 0.1f;   // °C; temperature and raw share it (raw: 1/16 °C)
constexpr float FPS_UNIT = 1.0f;    // frames per second

// units in thousandths, so the steps stay integers
constexpr int32_t toMilli(float value) {
    return (int32_t)(value * 1000.0f + 0.5f);
}

constexpr int32_t TEMP_UNIT_MILLI = toMilli(TEMP_UNIT);
constexpr int32_t FPS_UNIT_MILLI = toMilli(FPS_UNIT);
static_assert(TEMP_UNIT_MILLI >= 1 && FPS_UNIT_MILLI >= 1, "units must be at least 0.001");

// ---------- colors ----------

struct Rgb {
    uint8_t r;
    uint8_t g;
    uint8_t b;
};

// brightness 0 ~ 1 (0.299 R + 0.587 G + 0.114 B); the end colors need it above 0.299 (pure red)
constexpr float VALUE_LUMA = 0.80f;
constexpr float LABEL_LUMA = 0.75f;
static_assert(VALUE_LUMA > 0.299f && VALUE_LUMA <= 1.0f, "VALUE_LUMA must be 0.3 ~ 1");

constexpr uint8_t toChannel(float value) {
    return (uint8_t)(value * 255.0f + 0.5f);
}

// a gray of that brightness; red / blue at full, the other two channels raised to reach it
constexpr Rgb grayColor(float luma) {
    return { toChannel(luma), toChannel(luma), toChannel(luma) };
}

constexpr Rgb redColor(float luma) {
    return { 255, toChannel((luma - 0.299f) / 0.701f), toChannel((luma - 0.299f) / 0.701f) };
}

constexpr Rgb blueColor(float luma) {
    return { toChannel((luma - 0.114f) / 0.886f), toChannel((luma - 0.114f) / 0.886f), 255 };
}

constexpr Rgb NEUTRAL_COLOR = grayColor(VALUE_LUMA);
constexpr Rgb RISING_COLOR = redColor(VALUE_LUMA);
constexpr Rgb FALLING_COLOR = blueColor(VALUE_LUMA);
constexpr Rgb LABEL_COLOR = grayColor(LABEL_LUMA);
constexpr uint8_t FULL_STEPS = 5;   // steps for the whole end color
constexpr uint8_t SHARE_ALL = 16;   // shares: 1, 2, 4, 8, 16 of 16

uint16_t toRgb565(const Rgb &color) {
    return RGB565::color(color.r, color.g, color.b);
}

uint8_t mix(uint8_t from, uint8_t to, uint8_t share) {
    return (uint8_t)(from + ((int16_t)to - from) * share / SHARE_ALL);
}

// change and unit in the same thousandths
uint16_t changeColor(int32_t changeMilli, int32_t unitMilli) {
    int32_t steps = (changeMilli < 0 ? -changeMilli : changeMilli) / unitMilli;
    if (steps == 0) {
        return toRgb565(NEUTRAL_COLOR);
    }
    // doubling: 1 step = 1/16, then 1/8, 1/4, 1/2, all
    uint8_t share = steps >= FULL_STEPS ? SHARE_ALL : (uint8_t)(1 << (steps - 1));
    const Rgb &end = changeMilli > 0 ? RISING_COLOR : FALLING_COLOR;
    Rgb mixed = { mix(NEUTRAL_COLOR.r, end.r, share), mix(NEUTRAL_COLOR.g, end.g, share), mix(NEUTRAL_COLOR.b, end.b, share) };
    return toRgb565(mixed);
}

// ---------- values ----------

// a value after its label: drawn every frame; a new text first erases the old one
// (the old text drawn in black: only its pixels change, so nothing flickers)
struct Value {
    int16_t x;
    int16_t y;
    char text[16];
};

constexpr int16_t LEFT = 0;

// x set in setup(): after the widest label, measured with the font
Value tempValue = { 0, 45, "" };
Value rawValue = { 0, 105, "" };
Value fpsValue = { 0, 165, "" };

// returns x after the text
int16_t showValue(Value &value, const char *text, uint16_t color) {
    if (strcmp(value.text, text) != 0) {
        screen.drawTexts(value.x, value.y, RGB565::BLACK, value.text);
        strncpy(value.text, text, sizeof(value.text) - 1);
        value.text[sizeof(value.text) - 1] = '\0';
    }
    return screen.drawTexts(value.x, value.y, color, value.text);
}

// "\circ C" after the temperature: x < 0 = not shown
int16_t unitX = -1;

// the 5 chars \ c i r c, then " C"
const char UNIT[] = " \\circ C";

void drawUnit(int16_t x, uint16_t color) {
    screen.drawTexts(x, tempValue.y, color, UNIT);
}

void showUnit(int16_t x) {
    if (x != unitX && unitX >= 0) {
        drawUnit(unitX, RGB565::BLACK);
    }
    unitX = x;
    if (unitX >= 0) {
        drawUnit(unitX, toRgb565(LABEL_COLOR));
    }
}

// ---------- sensor (no waiting: the screen keeps drawing while it converts) ----------

bool sensorReady = false;
bool converting = false;
bool hasRaw = false;
int16_t raw = 0;
int16_t rawChange = 0;

// asked every frame: while converting the sensor answers 0; a pulled-out DQ reads 1 (pull-up),
// so the read that follows finds no sensor at once
void updateSensor() {
    if (!sensorReady) {
        sensorReady = sensor.init(12) == Sensor::OK;
        converting = false;
        if (!sensorReady) {
            hasRaw = false;
            return;
        }
    }
    if (!converting) {
        if (sensor.startConversion() != Sensor::OK) {
            sensorReady = false;
            hasRaw = false;
            return;
        }
        converting = true;
        return;
    }
    if (!sensor.isConversionDone()) {
        return;
    }
    converting = false;
    int16_t value;
    uint8_t result = sensor.readRaw(value);
    if (result == Sensor::ERROR_NO_SENSOR) {
        sensorReady = false;
        hasRaw = false;
        return;
    }
    if (result != Sensor::OK) {
        // CRC error: keep the last value, try again
        return;
    }
    rawChange = hasRaw ? (int16_t)(value - raw) : 0;
    raw = value;
    hasRaw = true;
}

// ---------- frame rate ----------

uint32_t fpsStartMs = 0;
uint16_t frameCount = 0;
int32_t fpsTenths = 0;        // frames per second x 10
int32_t fpsChangeTenths = 0;
bool hasFps = false;

void countFrame() {
    frameCount++;
    uint32_t elapsed = millis() - fpsStartMs;
    if (elapsed < 1000) {
        return;
    }
    int32_t value = (int32_t)((uint32_t)frameCount * 10000UL / elapsed);
    fpsChangeTenths = hasFps ? value - fpsTenths : 0;
    fpsTenths = value;
    hasFps = true;
    frameCount = 0;
    fpsStartMs = millis();
}

// ---------- main ----------

void setup() {
    screen.init();
    screen.drawFilledScreen(RGB565::BLACK);
    screen.setFont<Font>();
    // drawTexts() returns x after the text: the values start after the widest label (its space included)
    uint16_t labelColor = toRgb565(LABEL_COLOR);
    int16_t valueX = screen.drawTexts(LEFT, tempValue.y, labelColor, "Temp: ");
    int16_t end = screen.drawTexts(LEFT, rawValue.y, labelColor, "Raw: ");
    valueX = end > valueX ? end : valueX;
    end = screen.drawTexts(LEFT, fpsValue.y, labelColor, "FPS: ");
    valueX = end > valueX ? end : valueX;
    tempValue.x = valueX;
    rawValue.x = valueX;
    fpsValue.x = valueX;
    fpsStartMs = millis();
}

void loop() {
    updateSensor();

    // one frame: every value drawn again
    char text[16];
    // raw: 1/16 °C = 62.5 thousandths of °C
    uint16_t sensorColor = changeColor((int32_t)rawChange * 125 / 2, TEMP_UNIT_MILLI);
    if (hasRaw) {
        // 23.5: tenths of °C, rounded half away from zero
        int16_t centi = Sensor::toCentiCelsius(raw);
        int16_t tenths = (int16_t)((centi + (centi < 0 ? -5 : 5)) / 10);
        int16_t size = tenths < 0 ? -tenths : tenths;
        snprintf(text, sizeof(text), "%s%d.%d", tenths < 0 ? "-" : "", size / 10, size % 10);
        // a new width moves the unit: erase it first, the new digits may cover where it was
        if (strcmp(tempValue.text, text) != 0) {
            showUnit(-1);
        }
        int16_t end = showValue(tempValue, text, sensorColor);
        showUnit(end);

        snprintf(text, sizeof(text), "%d", raw);
        showValue(rawValue, text, sensorColor);
    } else {
        showUnit(-1);
        showValue(tempValue, "no sensor", toRgb565(NEUTRAL_COLOR));
        showValue(rawValue, "no sensor", toRgb565(NEUTRAL_COLOR));
    }

    if (hasFps) {
        snprintf(text, sizeof(text), "%ld.%ld", (long)(fpsTenths / 10), (long)(fpsTenths % 10));
    } else {
        strcpy(text, "-");
    }
    showValue(fpsValue, text, changeColor(fpsChangeTenths * 100, FPS_UNIT_MILLI));

    countFrame();
}
