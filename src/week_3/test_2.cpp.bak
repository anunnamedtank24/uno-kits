#include <Arduino.h>
#include "Uno_serial.h"
#include "Uno_one_wire.h"
#include "temp_sensor.h"

// UNO + DS18B20 temperature sensor (VCC, DQ, GND)
// VCC -> 5V, DQ -> D2, GND -> GND; DQ needs a 4.7 kΩ pull-up to VCC (most modules have one)
// the temperature goes to the USB serial once a second, as text:
//   pio device monitor -b 1000000
using SensorWire = Uno::UnoOneWire<2>;
using Link = Uno::UnoSerial<1000000>;
temp_sensor::DS18B20<SensorWire> sensor;

constexpr uint16_t PERIOD_MS = 1000;

// ---------- text over the serial link ----------

void printText(const char *text) {
    while (*text) {
        Link::write8((uint8_t)*text);
        text++;
    }
}

void printNumber(int32_t value) {
    if (value < 0) {
        Link::write8('-');
        value = -value;
    }
    char digits[11];
    uint8_t i = sizeof(digits) - 1;
    digits[i] = '\0';
    do {
        i--;
        digits[i] = (char)('0' + value % 10);
        value /= 10;
    } while (value > 0);
    printText(&digits[i]);
}

// 2350 -> "23.50", -125 -> "-1.25"
void printCentiCelsius(int16_t centiCelsius) {
    int32_t value = centiCelsius;
    if (value < 0) {
        Link::write8('-');
        value = -value;
    }
    printNumber(value / 100);
    Link::write8('.');
    int32_t fraction = value % 100;
    if (fraction < 10) {
        Link::write8('0');
    }
    printNumber(fraction);
}

void printResult(uint8_t result) {
    using Sensor = temp_sensor::DS18B20<SensorWire>;
    if (result == Sensor::ERROR_NO_SENSOR) {
        printText("error: no sensor (check DQ on D2, the pull-up, VCC / GND)");
    } else if (result == Sensor::ERROR_CRC) {
        printText("error: CRC (noise, long wire or weak pull-up)");
    } else if (result == Sensor::ERROR_TIMEOUT) {
        printText("error: timeout (parasite power is not supported: connect VCC)");
    } else if (result == Sensor::ERROR_RESOLUTION) {
        printText("error: resolution must be 9 ~ 12 bits");
    } else {
        printText("error ");
        printNumber(result);
    }
}

// ---------- test ----------

void setup() {
    Link::init();
    printText("\r\nDS18B20 on D2\r\n");
    uint8_t result = sensor.init(12);
    if (result != temp_sensor::DS18B20<SensorWire>::OK) {
        printResult(result);
        printText("\r\n");
        return;
    }
    printText("resolution ");
    printNumber(sensor.resolution());
    printText(" bits, conversion ");
    printNumber(sensor.conversionMs());
    printText(" ms\r\n");
}

void loop() {
    uint32_t startMs = millis();

    int16_t raw = 0;
    uint8_t result = sensor.startConversion();
    if (result == temp_sensor::DS18B20<SensorWire>::OK) {
        // the sensor answers 0 while converting
        bool done = false;
        while (!done && millis() - startMs < (uint32_t)sensor.conversionMs() + 50) {
            done = sensor.isConversionDone();
        }
        result = done ? sensor.readRaw(raw) : temp_sensor::DS18B20<SensorWire>::ERROR_TIMEOUT;
    }

    if (result == temp_sensor::DS18B20<SensorWire>::OK) {
        printCentiCelsius(temp_sensor::DS18B20<SensorWire>::toCentiCelsius(raw));
        printText(" C (raw ");
        printNumber(raw);
        printText(", ");
        printNumber(millis() - startMs);
        printText(" ms)");
        if (raw == temp_sensor::POWER_ON_RAW) {
            printText("  85.00 is also the power-on value: the conversion may not have run");
        }
    } else {
        printResult(result);
    }
    printText("\r\n");

    // one line per PERIOD_MS
    while (millis() - startMs < PERIOD_MS) {
    }
}
